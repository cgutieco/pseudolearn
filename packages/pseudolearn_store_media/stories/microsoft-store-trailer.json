        "    Definir temperatura Como Entero <- 30;",
        "    Definir lecturas Como Entero <- 0;",
        "    Mientras temperatura > 24 Hacer",
        "        temperatura <- temperatura - 3;",
        "        lecturas <- lecturas + 1;",
        "        Escribir \"Lectura \", lecturas, \": \", temperatura, \" grados\";",
