{
  "name": "pseudolearn-store-media",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "22.23.3"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "check:types": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "pnpm check:types && pnpm check:architecture && pnpm check:comments && pnpm check:size",
    "test": "vitest run",
    "media": "node src/cli/main.ts",
    "generate:brand": "cd ../pseudolearn_brand && python3 -m pseudolearn_brand build"
  },
  "dependencies": {
    "@hyperframes/producer": "0.8.216",
    "gsap": "3.15.0",
    "hyperframes": "0.8.216"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
