{
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "help-catalog/1"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    }
  },
  "required": [
    "format",
    "cards",
    "exclusions"
  ],
  "additionalProperties": false,
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "keyword",
            "operator",
            "builtin",
            "construction",
            "role",
            "type"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "properties": {
        "editions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["2026"]
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["es", "en"]
          }
        },
        "strictness": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["estricto", "flexible"]
          }
        }
      },
      "required": [
        "editions",
        "profiles",
        "strictness"
      ],
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "properties": {
        "specification": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "specification",
        "version",
        "element"
      ],
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "properties": {
        "specification": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "case": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "enum": ["es", "en"]
        },
        "strictness": {
          "type": "string",
          "enum": ["estricto", "flexible"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "specification",
        "version",
        "case",
        "profile",
        "strictness",
        "label"
      ],
      "additionalProperties": false
    },
    "tokenIdentity": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/anchor"
        }
      },
      "required": [
        "identity",
        "source"
      ],
      "additionalProperties": false
    },
    "part": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "identity",
        "text"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "common_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        }
      },
      "required": [
        "title",
        "summary",
        "purpose",
        "parts",
        "constraints",
        "common_errors",
        "examples"
      ],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tokenIdentity"
          }
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "content": {
          "type": "object",
          "properties": {
            "es": {
              "$ref": "#/$defs/content"
            },
            "en": {
              "$ref": "#/$defs/content"
            }
          },
          "required": ["es", "en"],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "identity",
        "tokens",
        "availability",
        "anchors",
        "content"
      ],
      "additionalProperties": false
    },
    "exclusion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "reason": {
          "type": "string",
          "enum": [
            "alias_of",
            "not_user_visible",
            "outside_edition_scope",
            "not_pedagogical"
          ]
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        }
      },
      "required": [
        "id",
        "identity",
        "availability",
        "reason",
        "anchor"
      ],
      "additionalProperties": false
    }
  }
}
