{
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "help-catalog/1"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    }
  },
  "required": [
    "format",
    "cards",
    "inventory",
    "exclusions"
  ],
  "additionalProperties": false,
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "keyword",
            "operator",
            "builtin",
            "construction",
            "role",
            "type"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "roleInventory": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "productions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tokens": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "identity",
        "productions",
        "tokens"
      ],
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "properties": {
        "operators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/roleInventory"
          }
        }
      },
      "required": [
        "operators",
        "roles"
      ],
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "properties": {
        "editions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "2027"
            ]
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "es",
              "en"
            ]
          }
        }
      },
      "required": [
        "editions",
        "profiles"
      ],
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "properties": {
        "specification": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "specification",
        "version",
        "element"
      ],
      "additionalProperties": false
    },
    "tokenIdentity": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/anchor"
        }
      },
      "required": [
        "identity",
        "source"
      ],
      "additionalProperties": false
    },
    "part": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "identity",
        "text"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "common_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commonError"
          }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/example"
          }
        }
      },
      "required": [
        "title",
        "summary",
        "parts",
        "slots",
        "rules",
        "common_errors",
        "examples"
      ],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tokenIdentity"
          }
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "block",
            "instruction",
            "symbol",
            "function",
            "type",
            "value"
          ]
        },
        "form": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/formLine"
          }
        },
        "content": {
          "type": "object",
          "properties": {
            "es": {
              "$ref": "#/$defs/content"
            },
            "en": {
              "$ref": "#/$defs/content"
            }
          },
          "required": [
            "es",
            "en"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "identity",
        "tokens",
        "availability",
        "anchors",
        "category",
        "form",
        "content"
      ],
      "additionalProperties": false
    },
    "exclusion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "reason": {
          "type": "string",
          "enum": [
            "alias_of",
            "not_user_visible",
            "outside_edition_scope",
            "not_pedagogical"
          ]
        },
        "alias_of": {
          "$ref": "#/$defs/identity"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        }
      },
      "required": [
        "id",
        "identity",
        "availability",
        "reason",
        "anchor"
      ],
      "additionalProperties": false
    },
    "caseReference": {
      "type": "object",
      "properties": {
        "specification": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "case": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "specification",
        "version",
        "case"
      ],
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "properties": {
        "specification": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "case": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "executable",
            "accepted",
            "diagnostic"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "specification",
        "version",
        "case",
        "kind",
        "note"
      ],
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "label",
        "text"
      ],
      "additionalProperties": false
    },
    "commonError": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "case": {
          "$ref": "#/$defs/caseReference"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "segment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "minLength": 1
            },
            "join": {
              "type": "boolean"
            }
          },
          "required": [
            "token"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "slot": {
              "type": "string",
              "minLength": 1
            },
            "join": {
              "type": "boolean"
            }
          },
          "required": [
            "slot"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ellipsis": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "ellipsis"
          ],
          "additionalProperties": false
        }
      ]
    },
    "formLine": {
      "type": "object",
      "properties": {
        "indent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      },
      "required": [
        "indent",
        "segments"
      ],
      "additionalProperties": false
    }
  }
}
