diff -ruN pseudolearn_codegen/src/experiments.rs codegen-exp/src/experiments.rs
--- pseudolearn_codegen/src/experiments.rs	1969-12-31 19:00:00
+++ codegen-exp/src/experiments.rs	2026-10-18 23:44:02
@@ -0,0 +1,449 @@
+use cranelift_codegen::cursor::{Cursor, FuncCursor};
+use cranelift_codegen::ir::condcodes::IntCC;
+use cranelift_codegen::ir::{
+    AliasRegionData, Block, BlockArg, Function, InstBuilder, InstructionData, Opcode, Value, ValueDef, types,
+};
+use std::collections::{HashMap, HashSet};
+
+pub(crate) fn enabled(name: &str) -> bool {
+    std::env::var("PL_EXPERIMENTS").unwrap_or_default().split(',').any(|flag| flag == name)
+}
+
+pub(crate) fn apply(func: &mut Function) {
+    if enabled("constbranch") {
+        constant_branches(func);
+        single_predecessor_params(func);
+    }
+    if enabled("deadparams") {
+        dead_params(func);
+    }
+    if enabled("ovfconst") {
+        overflow_constants(func);
+    }
+    if enabled("terminal") {
+        terminal_slow_paths(func);
+    }
+    if enabled("alias") {
+        alias_regions(func);
+    }
+    if enabled("sharedfault") {
+        shared_fault_blocks(func);
+    }
+}
+
+fn dead_params(func: &mut Function) {
+    let Some(entry) = func.layout.entry_block() else { return };
+    let mut owner: HashMap<Value, (Block, usize)> = HashMap::new();
+    let blocks: Vec<Block> = func.layout.blocks().collect();
+    for &block in &blocks {
+        if block == entry {
+            continue;
+        }
+        for (index, &param) in func.dfg.block_params(block).iter().enumerate() {
+            owner.insert(param, (block, index));
+        }
+    }
+    let mut live: HashSet<Value> = HashSet::new();
+    let mut flows: Vec<(Value, Value)> = Vec::new();
+    for &block in &blocks {
+        let insts: Vec<_> = func.layout.block_insts(block).collect();
+        for inst in insts {
+            for &argument in func.dfg.inst_args(inst) {
+                let resolved = func.dfg.resolve_aliases(argument);
+                if owner.contains_key(&resolved) {
+                    live.insert(resolved);
+                }
+            }
+            let data = &func.dfg.insts[inst];
+            for destination in data.branch_destination(&func.dfg.jump_tables, &func.dfg.exception_tables) {
+                let target = destination.block(&func.dfg.value_lists);
+                let params = func.dfg.block_params(target).to_vec();
+                for (index, argument) in destination.args(&func.dfg.value_lists).enumerate() {
+                    if let BlockArg::Value(value) = argument {
+                        let resolved = func.dfg.resolve_aliases(value);
+                        if let Some(&param) = params.get(index) {
+                            flows.push((resolved, param));
+                        }
+                    }
+                }
+            }
+        }
+    }
+    let mut changed = true;
+    while changed {
+        changed = false;
+        for &(argument, param) in &flows {
+            if (live.contains(&param) || !owner.contains_key(&param)) && owner.contains_key(&argument) && live.insert(argument) {
+                changed = true;
+            }
+        }
+    }
+    let mut dead: HashMap<Block, Vec<usize>> = HashMap::new();
+    for (&param, &(block, index)) in &owner {
+        if !live.contains(&param) {
+            dead.entry(block).or_default().push(index);
+        }
+    }
+    for indices in dead.values_mut() {
+        indices.sort_unstable_by(|a, b| b.cmp(a));
+    }
+    for &block in &blocks {
+        let insts: Vec<_> = func.layout.block_insts(block).collect();
+        for inst in insts {
+            let dfg = &mut func.dfg;
+            let data = &mut dfg.insts[inst];
+            for destination in data.branch_destination_mut(&mut dfg.jump_tables, &mut dfg.exception_tables) {
+                let target = destination.block(&dfg.value_lists);
+                if let Some(indices) = dead.get(&target) {
+                    for &index in indices {
+                        destination.remove(index, &mut dfg.value_lists);
+                    }
+                }
+            }
+        }
+    }
+    for (block, indices) in &dead {
+        let params = func.dfg.block_params(*block).to_vec();
+        for &index in indices {
+            func.dfg.remove_block_param(params[index]);
+        }
+    }
+}
+
+fn constant_of(func: &Function, value: Value) -> Option<i64> {
+    let value = func.dfg.resolve_aliases(value);
+    if let ValueDef::Result(inst, _) = func.dfg.value_def(value) {
+        if let InstructionData::UnaryImm { opcode: Opcode::Iconst, imm } = func.dfg.insts[inst] {
+            return Some(imm.bits());
+        }
+    }
+    None
+}
+
+fn overflow_constants(func: &mut Function) {
+    let mut targets = Vec::new();
+    for block in func.layout.blocks() {
+        for inst in func.layout.block_insts(block) {
+            let opcode = func.dfg.insts[inst].opcode();
+            if (opcode == Opcode::SaddOverflow || opcode == Opcode::SsubOverflow)
+                && func.dfg.value_type(func.dfg.inst_results(inst)[0]) == types::I64
+            {
+                targets.push(inst);
+            }
+        }
+    }
+    for inst in targets {
+        let opcode = func.dfg.insts[inst].opcode();
+        let args = func.dfg.inst_args(inst).to_vec();
+        let (left, right) = (args[0], args[1]);
+        let (variable, constant) = match (constant_of(func, left), constant_of(func, right)) {
+            (_, Some(c)) => (left, c),
+            (Some(c), None) if opcode == Opcode::SaddOverflow => (right, c),
+            _ => continue,
+        };
+        let (condition, limit) = match (opcode, constant > 0) {
+            (_, _) if constant == 0 => continue,
+            (Opcode::SaddOverflow, true) => (IntCC::SignedGreaterThan, i64::MAX - constant),
+            (Opcode::SaddOverflow, false) => (IntCC::SignedLessThan, i64::MIN - constant),
+            (_, true) => (IntCC::SignedLessThan, i64::MIN + constant),
+            (_, false) => (IntCC::SignedGreaterThan, i64::MAX + constant),
+        };
+        let results = func.dfg.inst_results(inst).to_vec();
+        let mut cursor = FuncCursor::new(func).at_inst(inst);
+        let constant_value = cursor.ins().iconst(types::I64, constant);
+        let result = if opcode == Opcode::SaddOverflow {
+            cursor.ins().iadd(variable, constant_value)
+        } else {
+            cursor.ins().isub(variable, constant_value)
+        };
+        let limit_value = cursor.ins().iconst(types::I64, limit);
+        let flag = cursor.ins().icmp(condition, variable, limit_value);
+        func.dfg.detach_inst_results(inst);
+        func.dfg.change_to_alias(results[0], result);
+        func.dfg.change_to_alias(results[1], flag);
+        func.layout.remove_inst(inst);
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Region {
+    Context,
+    Heap,
+    Cells,
+    Roots,
+    Unknown,
+}
+
+fn classify(func: &Function, context: Value, address: Value, depth: u32) -> Region {
+    let address = func.dfg.resolve_aliases(address);
+    if address == context {
+        return Region::Context;
+    }
+    if depth > 8 {
+        return Region::Unknown;
+    }
+    match func.dfg.value_def(address) {
+        ValueDef::Result(inst, _) => match func.dfg.insts[inst] {
+            InstructionData::Load { opcode: Opcode::Load, arg, offset, .. } if func.dfg.resolve_aliases(arg) == context => {
+                match i32::from(offset) {
+                    0 => Region::Heap,
+                    32 => Region::Roots,
+                    64 => Region::Cells,
+                    _ => Region::Unknown,
+                }
+            }
+            InstructionData::Binary { opcode: Opcode::Iadd, args } => {
+                let first = classify(func, context, args[0], depth + 1);
+                if first != Region::Unknown {
+                    first
+                } else {
+                    classify(func, context, args[1], depth + 1)
+                }
+            }
+            _ => Region::Unknown,
+        },
+        _ => Region::Unknown,
+    }
+}
+
+fn alias_regions(func: &mut Function) {
+    let Some(entry) = func.layout.entry_block() else { return };
+    let Some(&context) = func.dfg.block_params(entry).first() else { return };
+    let names = [(Region::Context, 1, "context"), (Region::Heap, 2, "heap"), (Region::Cells, 3, "cells"), (Region::Roots, 4, "roots")];
+    let mut regions = HashMap::new();
+    for (region, id, name) in names {
+        let handle = func.dfg.alias_regions.insert(AliasRegionData { user_id: id, description: name.into() });
+        regions.insert(id, (region, handle));
+    }
+    let mut updates = Vec::new();
+    for block in func.layout.blocks() {
+        for inst in func.layout.block_insts(block) {
+            let (address, flags) = match func.dfg.insts[inst] {
+                InstructionData::Load { arg, flags, .. } => (arg, flags),
+                InstructionData::Store { args, flags, .. } => (args[1], flags),
+                _ => continue,
+            };
+            let region = classify(func, context, address, 0);
+            if region == Region::Unknown {
+                continue;
+            }
+            let handle = regions.values().find(|(kind, _)| *kind == region).map(|(_, handle)| *handle);
+            let data = func.dfg.mem_flags[flags].with_alias_region(handle);
+            updates.push((inst, data));
+        }
+    }
+    for (inst, data) in updates {
+        let interned = func.dfg.mem_flags.insert_unchecked(data);
+        match &mut func.dfg.insts[inst] {
+            InstructionData::Load { flags, .. } | InstructionData::Store { flags, .. } => *flags = interned,
+            _ => {}
+        }
+    }
+}
+
+const ACCESS_ENTRIES: [u32; 6] = [16, 17, 18, 19, 25, 26];
+const CELL_ENTRIES: [u32; 2] = [25, 26];
+
+fn callee_index(func: &Function, inst: cranelift_codegen::ir::Inst) -> Option<u32> {
+    let InstructionData::Call { func_ref, .. } = func.dfg.insts[inst] else { return None };
+    match func.dfg.ext_funcs[func_ref].name {
+        cranelift_codegen::ir::ExternalName::User(reference) => Some(func.params.user_named_funcs()[reference].index),
+        _ => None,
+    }
+}
+
+pub(crate) fn terminal_slow_paths(func: &mut Function) {
+    let blocks: Vec<Block> = func.layout.blocks().collect();
+    for block in blocks {
+        if !func.layout.is_cold(block) {
+            continue;
+        }
+        let insts: Vec<_> = func.layout.block_insts(block).collect();
+        let Some(&last) = insts.last() else { continue };
+        let Some(call) = insts.iter().rev().skip(1).find(|inst| func.dfg.insts[**inst].opcode() == Opcode::Call).copied() else { continue };
+        let Some(index) = callee_index(func, call) else { continue };
+        if !ACCESS_ENTRIES.contains(&index) || (CELL_ENTRIES.contains(&index) && !enabled("terminalcells")) {
+            continue;
+        }
+        let Some(status) = func.dfg.inst_results(call).first().copied() else { continue };
+        let InstructionData::Brif { arg, blocks, .. } = func.dfg.insts[last] else { continue };
+        if func.dfg.resolve_aliases(arg) != func.dfg.resolve_aliases(status) {
+            continue;
+        }
+        let taken = blocks[0].block(&func.dfg.value_lists);
+        if !func.dfg.block_params(taken).is_empty() || blocks[0].len(&func.dfg.value_lists) != 0 {
+            continue;
+        }
+        if let InstructionData::Brif { blocks, .. } = &mut func.dfg.insts[last] {
+            blocks[1] = blocks[0];
+        }
+    }
+}
+
+fn icmp_constant(func: &Function, value: Value) -> Option<bool> {
+    if let Some(constant) = constant_of(func, value) {
+        return Some(constant != 0);
+    }
+    let value = func.dfg.resolve_aliases(value);
+    let ValueDef::Result(inst, _) = func.dfg.value_def(value) else { return None };
+    let InstructionData::IntCompare { cond, args, .. } = func.dfg.insts[inst] else { return None };
+    let (left, right) = (constant_of(func, args[0])?, constant_of(func, args[1])?);
+    Some(match cond {
+        IntCC::Equal => left == right,
+        IntCC::NotEqual => left != right,
+        IntCC::SignedLessThan => left < right,
+        IntCC::SignedLessThanOrEqual => left <= right,
+        IntCC::SignedGreaterThan => left > right,
+        IntCC::SignedGreaterThanOrEqual => left >= right,
+        _ => return None,
+    })
+}
+
+pub(crate) fn constant_branches(func: &mut Function) {
+    let blocks: Vec<Block> = func.layout.blocks().collect();
+    for block in blocks {
+        let Some(last) = func.layout.last_inst(block) else { continue };
+        let InstructionData::Brif { arg, blocks: targets, .. } = func.dfg.insts[last] else { continue };
+        let Some(taken) = icmp_constant(func, arg) else { continue };
+        let chosen = if taken { targets[0] } else { targets[1] };
+        func.dfg.insts[last] = InstructionData::Jump { opcode: Opcode::Jump, destination: chosen };
+    }
+}
+
+pub(crate) fn single_predecessor_params(func: &mut Function) {
+    let Some(entry) = func.layout.entry_block() else { return };
+    let mut reachable = HashSet::new();
+    let mut stack = vec![entry];
+    while let Some(block) = stack.pop() {
+        if !reachable.insert(block) {
+            continue;
+        }
+        for inst in func.layout.block_insts(block) {
+            for destination in func.dfg.insts[inst].branch_destination(&func.dfg.jump_tables, &func.dfg.exception_tables) {
+                stack.push(destination.block(&func.dfg.value_lists));
+            }
+        }
+    }
+    let unreachable: Vec<Block> = func.layout.blocks().filter(|block| !reachable.contains(block)).collect();
+    for block in unreachable {
+        let insts: Vec<_> = func.layout.block_insts(block).collect();
+        for inst in insts {
+            func.layout.remove_inst(inst);
+        }
+        func.layout.remove_block(block);
+    }
+    let mut incoming: HashMap<Block, Vec<(cranelift_codegen::ir::Inst, usize)>> = HashMap::new();
+    for &block in &reachable {
+        for inst in func.layout.block_insts(block) {
+            for (position, destination) in func.dfg.insts[inst].branch_destination(&func.dfg.jump_tables, &func.dfg.exception_tables).iter().enumerate() {
+                incoming.entry(destination.block(&func.dfg.value_lists)).or_default().push((inst, position));
+            }
+        }
+    }
+    for (block, edges) in incoming {
+        if edges.len() != 1 || block == entry {
+            continue;
+        }
+        let (inst, position) = edges[0];
+        if !matches!(func.dfg.insts[inst], InstructionData::Jump { .. }) {
+            continue;
+        }
+        let params = func.dfg.block_params(block).to_vec();
+        if params.is_empty() {
+            continue;
+        }
+        let arguments: Vec<Value> = func.dfg.insts[inst].branch_destination(&func.dfg.jump_tables, &func.dfg.exception_tables)[position]
+            .args(&func.dfg.value_lists)
+            .filter_map(|argument| if let BlockArg::Value(value) = argument { Some(value) } else { None })
+            .collect();
+        if arguments.len() != params.len() {
+            continue;
+        }
+        {
+            let dfg = &mut func.dfg;
+            let data = &mut dfg.insts[inst];
+            dfg_clear(data, &mut dfg.jump_tables, &mut dfg.exception_tables, &mut dfg.value_lists, position);
+        }
+        for (param, argument) in params.iter().zip(arguments) {
+            func.dfg.remove_block_param(*param);
+            if func.dfg.resolve_aliases(argument) != *param {
+                func.dfg.change_to_alias(*param, argument);
+            }
+        }
+    }
+}
+
+fn dfg_clear(
+    data: &mut InstructionData,
+    jump_tables: &mut cranelift_codegen::ir::JumpTables,
+    exception_tables: &mut cranelift_codegen::ir::ExceptionTables,
+    pool: &mut cranelift_codegen::ir::ValueListPool,
+    position: usize,
+) {
+    if let Some(destination) = data.branch_destination_mut(jump_tables, exception_tables).get_mut(position) {
+        destination.clear(pool);
+    }
+}
+
+pub(crate) fn shared_fault_blocks(func: &mut Function) {
+    let Some(entry) = func.layout.entry_block() else { return };
+    let Some(&context) = func.dfg.block_params(entry).first() else { return };
+    let returns = func.signature.returns.clone();
+    let mut candidates = Vec::new();
+    for block in func.layout.blocks() {
+        if !func.layout.is_cold(block) || !func.dfg.block_params(block).is_empty() {
+            continue;
+        }
+        let insts: Vec<_> = func.layout.block_insts(block).collect();
+        let Some(call) = insts.iter().copied().find(|inst| func.dfg.insts[*inst].opcode() == Opcode::Call) else { continue };
+        if callee_index(func, call) != Some(0) {
+            continue;
+        }
+        let Some(&last) = insts.last() else { continue };
+        if func.dfg.insts[last].opcode() != Opcode::Return {
+            continue;
+        }
+        let arguments = func.dfg.inst_args(call).to_vec();
+        if arguments.len() != 2 || func.dfg.resolve_aliases(arguments[0]) != context {
+            continue;
+        }
+        let only_simple = insts.iter().all(|inst| {
+            matches!(func.dfg.insts[*inst].opcode(), Opcode::Iconst | Opcode::F64const | Opcode::Call | Opcode::Return)
+        });
+        if !only_simple {
+            continue;
+        }
+        candidates.push((block, call, arguments[1]));
+    }
+    if candidates.len() < 2 {
+        return;
+    }
+    let shared = func.dfg.make_block();
+    let site_param = func.dfg.append_block_param(shared, types::I32);
+    func.layout.append_block(shared);
+    func.layout.set_cold(shared);
+    let template_call = candidates[0].1;
+    let InstructionData::Call { func_ref, .. } = func.dfg.insts[template_call] else { return };
+    {
+        let mut cursor = FuncCursor::new(func).at_bottom(shared);
+        cursor.ins().call(func_ref, &[context, site_param]);
+        let mut zeros = Vec::new();
+        for parameter in &returns {
+            let zero = match parameter.value_type {
+                types::F64 => cursor.ins().f64const(0.0),
+                other => cursor.ins().iconst(other, 0),
+            };
+            zeros.push(zero);
+        }
+        cursor.ins().return_(&zeros);
+    }
+    for (block, call, site) in candidates {
+        let insts: Vec<_> = func.layout.block_insts(block).collect();
+        let call_position = insts.iter().position(|inst| *inst == call).unwrap_or(0);
+        for inst in insts.into_iter().skip(call_position) {
+            func.layout.remove_inst(inst);
+        }
+        let mut cursor = FuncCursor::new(func).at_bottom(block);
+        cursor.ins().jump(shared, &[BlockArg::Value(site)]);
+    }
+}
