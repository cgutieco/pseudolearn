---
export interface MetricItem {
  readonly value: string;
  readonly label: string;
}

export interface Props {
  items: readonly MetricItem[];
}

const { items } = Astro.props;
---

<dl class="metrics">
  {items.map((item) => (
    <div class="metrics__item">
      <dt class="metrics__label">{item.label}</dt>
      <dd class="metrics__value pl-mono">{item.value}</dd>
    </div>
  ))}
</dl>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    width: 100%;
    max-width: 760px;
    margin-top: var(--pl-space-2xl);
    overflow: hidden;
    border: 1px solid var(--pl-on-field-line);
    border-radius: var(--pl-radius-card);
    background: var(--pl-on-field-line);
  }

  .metrics__item {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: var(--pl-space-md);
    background: var(--pl-field);
  }

  .metrics__value {
    margin: 0;
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
    color: var(--pl-on-field);
  }

  .metrics__label {
    font-size: 13px;
    color: var(--pl-on-field-2);
  }

  @media (min-width: 700px) {
    .metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
