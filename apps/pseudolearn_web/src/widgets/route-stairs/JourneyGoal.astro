---
import { useTranslations } from '@shared/i18n/translator';
import type { Locale } from '@shared/i18n/locales';
import { ROUTES, localizePath } from '@shared/i18n/routes';
import { Icon } from '@shared/ui/icon';
import type { RouteLessonEntry } from '@entities/learning-route/model/route';
import { plainRouteText } from '@entities/learning-route/model/route-runs';

export interface Props {
  locale: Locale;
  goal: RouteLessonEntry;
}

const { locale, goal } = Astro.props;
const { t } = useTranslations(locale);
---

<article class="goal">
  <p class="pl-overline pl-overline--field">{t('home.stairs.goal')}</p>
  <h3 class="goal__title">{plainRouteText(goal.title)}</h3>
  <p class="goal__problem">{goal.brief_problem}</p>
  <a class="pl-btn pl-btn--on-field pl-btn--sm goal__cta" href={localizePath(ROUTES.learn, locale)}>
    <span>{t('home.stairs.cta')}</span>
    <Icon name="arrowRight" size={17} />
  </a>
</article>

<style>
  .goal {
    display: grid;
    gap: 6px;
    margin-bottom: var(--pl-space-lg);
    padding: var(--pl-space-lg);
    border-radius: var(--pl-radius-card);
    background: radial-gradient(80% 80% at 100% 0%, rgb(110 187 191 / 25%), transparent 70%), var(--pl-field);
    color: var(--pl-on-field-2);
    box-shadow: var(--pl-shadow-3);
  }

  .goal__title {
    margin: 0;
    font-size: 22px;
    letter-spacing: -0.015em;
    color: var(--pl-on-field);
  }

  .goal__problem {
    margin-top: var(--pl-space-xs);
    font-size: 17px;
    line-height: 1.55;
  }

  .goal__cta {
    justify-self: start;
    margin-top: var(--pl-space-sm);
  }
</style>
