---
import { useTranslations } from '@shared/i18n/translator';
import type { Locale } from '@shared/i18n/locales';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useTranslations(locale);
const PROMISES = [
  'contact.sidebar.promiseHuman',
  'contact.sidebar.promiseReply',
  'contact.sidebar.promiseNoGuarantee',
] as const;
---

<ol class="promises">
  {PROMISES.map((key, index) => (
    <li class="promises__item">
      <span class="promises__numeral pl-mono" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <p class="promises__text">{t(key)}</p>
    </li>
  ))}
</ol>

<style>
  .promises {
    display: grid;
    gap: var(--pl-space-lg);
  }

  .promises__item {
    display: grid;
    gap: var(--pl-space-xs);
    padding-left: var(--pl-space-md);
    border-left: 3px solid var(--pl-brand-tint);
  }

  .promises__numeral {
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    color: var(--pl-brand);
  }

  .promises__text {
    font-size: 18px;
    line-height: 1.5;
    color: var(--pl-ink);
  }

  @media (min-width: 900px) {
    .promises {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--pl-space-2xl);
    }
  }
</style>
