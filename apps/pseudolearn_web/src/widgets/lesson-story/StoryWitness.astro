---
import { useTranslations } from '@shared/i18n/translator';
import type { Locale } from '@shared/i18n/locales';
import { StairMark } from '@shared/ui/brand-mark';
import type { RouteLesson } from '@entities/learning-route/model/route';
import { plainRouteText } from '@entities/learning-route/model/route-runs';

export interface Props {
  locale: Locale;
  lesson: RouteLesson;
}

const { locale, lesson } = Astro.props;
const { t } = useTranslations(locale);
---

<aside class="witness" aria-hidden="true">
  <StairMark id="story" motion="story" class="witness__mark" />
  <p class="witness__lesson">
    <span class="pl-mono witness__meta">
      {t('home.lesson.meta', { number: lesson.number, minutes: lesson.minutes })}
    </span>
    <span class="witness__title">{plainRouteText(lesson.title)}</span>
  </p>
</aside>

<style>
  .witness {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: var(--pl-space-sm);
    margin-inline: calc(-1 * var(--pl-space-md));
    padding: 10px var(--pl-space-md);
    border-bottom: 1px solid var(--pl-line);
    background: color-mix(in srgb, var(--pl-canvas) 90%, transparent);
    backdrop-filter: blur(10px);
  }

  .witness :global(.witness__mark) {
    width: 40px;
    height: auto;
    flex: none;
    color: var(--pl-brand);
  }

  .witness__lesson {
    display: grid;
  }

  .witness__meta {
    font-size: 11px;
    color: var(--pl-ink-3);
  }

  .witness__title {
    font-weight: 700;
  }

  @media (min-width: 1100px) {
    .witness {
      top: 120px;
      align-self: start;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--pl-space-lg);
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      backdrop-filter: none;
    }

    .witness :global(.witness__mark) {
      width: 260px;
    }

    .witness__title {
      font-size: 22px;
    }
  }
</style>
