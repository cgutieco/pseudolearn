---
import type { SpecificationSection } from '@entities/specification/model/specification';
import type { Locale } from '@shared/i18n/locales';
import SpecBlocks from './SpecBlocks.astro';

export interface Props {
  section: SpecificationSection;
  locale: Locale;
}

const { section, locale } = Astro.props;
---

<article class="article">
  <SpecBlocks blocks={section.blocks} locale={locale} />
</article>

<style>
  .article {
    min-width: 0;
    max-width: 760px;
    color: var(--pl-ink);
    font-size: 1.0625rem;
  }

  .article :global(.runs__code),
  .article :global(code),
  .article :global(pre) {
    font-family: var(--pl-font-code);
  }

  .article :global(.runs__code) {
    padding: 1px 3px;
    border-radius: var(--pl-radius-sm);
    background: var(--pl-sunken);
    font-size: 0.92em;
    overflow-wrap: anywhere;
  }

  .article :global(.runs__slot),
  .article :global(.code__slot) {
    color: var(--pl-ink-2);
    font-style: italic;
  }

  .article :global(.runs__link) {
    color: var(--pl-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article :global(.code__optional) {
    color: var(--pl-brand);
    font-weight: 600;
  }

  .article :global(.code__token--structured) {
    color: var(--pl-syn-struct);
    font-weight: 600;
  }

  .article :global(.code__token--procedural) {
    color: var(--pl-syn-proc);
    font-weight: 600;
  }

  .article :global(.code__token--object) {
    color: var(--pl-syn-oop);
    font-weight: 600;
  }

  .article :global(.code__token--identifier) {
    color: var(--pl-syn-id);
  }

  .article :global(.code__token--number) {
    color: var(--pl-syn-num);
  }

  .article :global(.code__token--string) {
    color: var(--pl-syn-str);
  }

  .article :global(.code__token--muted) {
    color: var(--pl-ink-3);
  }
</style>
