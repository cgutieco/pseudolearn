---
export interface Props {
  overline: string;
  title: string;
  lead?: string;
  tone?: 'canvas' | 'field';
  level?: 'h2' | 'h3';
  id?: string;
}

const { overline, title, lead, tone = 'canvas', level = 'h2', id } = Astro.props;
const Heading = level;
---

<header class:list={['section-heading', `section-heading--${tone}`]}>
  <p class:list={['pl-overline', tone === 'field' ? 'pl-overline--field' : 'pl-overline--brand']}>
    {overline}
  </p>
  <Heading id={id} class="pl-section-title section-heading__title">
    {title}
  </Heading>
  {lead && (
    <p class:list={['pl-lede', 'section-heading__lead', { 'pl-lede--field': tone === 'field' }]}>{lead}</p>
  )}
</header>

<style>
  .section-heading {
    max-width: 820px;
  }

  .section-heading__title {
    margin-top: 14px;
  }

  .section-heading--field .section-heading__title {
    color: var(--pl-on-field);
  }

  .section-heading__lead {
    margin-top: var(--pl-space-md);
    max-width: 700px;
  }

  @media (min-width: 900px) {
    .section-heading__title {
      margin-top: 20px;
    }

    .section-heading__lead {
      margin-top: 20px;
    }
  }
</style>
