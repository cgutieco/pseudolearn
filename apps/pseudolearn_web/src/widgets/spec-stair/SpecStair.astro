---
export interface Props {
  steps: number;
}

const { steps } = Astro.props;
const bars = Array.from({ length: steps }, (_, index) => index);
---

<div class="spec-stair" aria-hidden="true">
  {bars.map((index) => (
    <span class="spec-stair__bar" style={`--pl-bar: ${index}; --pl-bars: ${steps}`}></span>
  ))}
</div>

<style>
  .spec-stair {
    display: flex;
    align-items: flex-end;
    gap: clamp(3px, 0.8vw, 6px);
    height: clamp(72px, 18vw, 120px);
  }

  .spec-stair__bar {
    width: clamp(8px, 2.4vw, 14px);
    height: calc((var(--pl-bar) + 1) / var(--pl-bars) * 100%);
    border-radius: var(--pl-radius-pill);
    background: currentcolor;
    transform-origin: bottom;
  }

  @media (prefers-reduced-motion: no-preference) {
    .spec-stair__bar {
      animation: spec-rise 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--pl-bar) * 60ms + 150ms) both;
    }
  }

  @keyframes spec-rise {
    from {
      transform: scaleY(0.05);
    }

    to {
      transform: none;
    }
  }
</style>
