---
import type { PartStory } from '@entities/learning-route/model/route-showcase';

export interface Props {
  stories: readonly PartStory[];
}

const { stories } = Astro.props;
---

<ul class="paradigms">
  {stories.map(({ part, question }) => (
    <li class="paradigms__tile">
      <span class="paradigms__numeral pl-mono" aria-hidden="true">
        {part.number}
      </span>
      <h3 class="paradigms__title">{part.title}</h3>
      {part.motto !== '' && <p class="paradigms__motto">{part.motto}</p>}
      <p class="paradigms__question">{question !== '' ? question : part.summary}</p>
    </li>
  ))}
</ul>

<style>
  .paradigms {
    display: grid;
    gap: var(--pl-space-md);
  }

  .paradigms__tile {
    position: relative;
    display: grid;
    gap: 6px;
    align-content: start;
    padding: var(--pl-space-lg);
    overflow: hidden;
    border: 1px solid var(--pl-line);
    border-radius: var(--pl-radius-card);
    background: var(--pl-surface);
  }

  .paradigms__tile::before {
    content: attr(data-numeral);
    position: absolute;
    font-family: var(--pl-font-code);
    top: -6px;
    right: 12px;
    font-size: 72px;
    font-weight: 700;
    line-height: 1;
    color: var(--pl-brand);
    opacity: 0.18;
  }

  .paradigms__title {
    margin: 0;
    font-size: 21px;
  }

  .paradigms__motto {
    color: var(--pl-brand);
    font-weight: 600;
  }

  .paradigms__question {
    margin-top: var(--pl-space-xs);
    font-size: 16px;
    line-height: 1.55;
    color: var(--pl-ink-2);
  }

  @media (min-width: 700px) {
    .paradigms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .paradigms {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
