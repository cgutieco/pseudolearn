---
export interface Props {
  size?: number;
  label?: string;
  ceremony?: boolean;
}

const { size = 24, label, ceremony = false } = Astro.props;
const SPARKLE = 'M0 -4Q.6 -.6 4 0Q.6 .6 0 4Q-.6 .6 -4 0Q-.6 -.6 0 -4Z';
---

<svg
  class:list={['nodo-glyph', { 'nodo-glyph--ceremony': ceremony }]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle class="nodo-glyph__node" cx="9" cy="15" r="5" pathLength="1"></circle>
    <path class="nodo-glyph__wire" d="M9 10V6.5h4.5" pathLength="1"></path>
  </g>
  <g class="nodo-glyph__eyes">
    <circle cx="7.25" cy="14.5" r="0.9" fill="currentColor"></circle>
    <circle cx="10.75" cy="14.5" r="0.9" fill="currentColor"></circle>
  </g>
  <g transform="translate(18 6.5)">
    <path class="nodo-glyph__sparkle" d={SPARKLE} fill="currentColor"></path>
  </g>
</svg>

<style>
  .nodo-glyph {
    flex: none;
    overflow: visible;
  }

  .nodo-glyph__eyes {
    transform-box: fill-box;
    transform-origin: center;
  }

  .nodo-glyph__sparkle {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nodo-glyph--ceremony .nodo-glyph__node,
    .nodo-glyph--ceremony .nodo-glyph__wire {
      stroke-dasharray: 1;
      animation: nodo-draw 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.2s both;
    }

    .nodo-glyph--ceremony .nodo-glyph__wire {
      animation-delay: 0.9s;
      animation-duration: 0.5s;
    }

    .nodo-glyph--ceremony .nodo-glyph__eyes {
      animation: nodo-blink 4s ease-in-out 1.2s infinite;
    }

    .nodo-glyph--ceremony .nodo-glyph__sparkle {
      animation:
        nodo-spark 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 1.3s both,
        nodo-twinkle 3s ease-in-out 2s infinite;
    }
  }

  @keyframes nodo-draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes nodo-blink {
    0%,
    92%,
    100% {
      transform: none;
    }

    96% {
      transform: scaleY(0.1);
    }
  }

  @keyframes nodo-spark {
    from {
      transform: scale(0) rotate(-90deg);
    }

    to {
      transform: none;
    }
  }

  @keyframes nodo-twinkle {
    0%,
    100% {
      transform: none;
    }

    50% {
      transform: scale(1.25) rotate(45deg);
    }
  }
</style>
