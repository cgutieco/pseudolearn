---
import { BRAND_SYMBOL_FLAG_PATH } from './symbol-path.generated';
import { FLAG_VIEW_BOX } from './stair-geometry';

export interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className } = Astro.props;
---

<svg
  viewBox={FLAG_VIEW_BOX}
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <path fill="currentColor" d={BRAND_SYMBOL_FLAG_PATH}></path>
</svg>
