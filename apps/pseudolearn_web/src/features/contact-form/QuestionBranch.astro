---
import { useTranslations } from '@shared/i18n/translator';
import type { Locale } from '@shared/i18n/locales';
import { Icon } from '@shared/ui/icon';
import { SelectField } from '@shared/ui/select-field';
import { routeParts } from '@entities/learning-route/model/route-contents';
import { plainRouteText } from '@entities/learning-route/model/route-runs';
import { specificationParts, specificationSubject } from '@entities/specification/model/specification-parts';
import { GENERAL_SUBJECT } from '@entities/contact-request/model/contact-subject';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useTranslations(locale);
const parts = routeParts(locale);
const specification = specificationParts(locale);
---

<div class="pl-branch pl-branch--question">
  <p class="pl-overline pl-overline--brand pl-branch__label">{t('contact.branch.question.label')}</p>
  <div class="pl-form-field">
    <label class="pl-form-field__label" for="subject-select">
      {t('contact.branch.question.subjectLabel')}
    </label>
    <SelectField id="subject-select" name="subject">
      {parts.map((part) => (
        <optgroup label={`${part.number} · ${part.title}`}>
          {part.lessons.map((lesson) => (
            <option value={lesson.id}>{`${lesson.number} · ${plainRouteText(lesson.title)}`}</option>
          ))}
        </optgroup>
      ))}
      <optgroup label={t('contact.branch.question.groupSpecs')}>
        {specification.map((part) => (
          <option value={specificationSubject(part)}>{`${part.number} · ${part.title}`}</option>
        ))}
      </optgroup>
      <optgroup label={t('contact.branch.question.groupGeneral')}>
        <option value={GENERAL_SUBJECT}>{t('contact.branch.question.generalOption')}</option>
      </optgroup>
    </SelectField>
    <span class="pl-form-field__help">{t('contact.branch.question.subjectHelp')}</span>
  </div>
  <p class="pl-notice pl-notice--info">
    <Icon name="info" size={18} />
    <span>{t('contact.branch.question.notice')}</span>
  </p>
</div>
