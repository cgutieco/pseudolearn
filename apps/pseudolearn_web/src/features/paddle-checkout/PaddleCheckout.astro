---
import { useTranslations } from '@shared/i18n/translator';
import type { Locale } from '@shared/i18n/locales';
import { STATUS_KEYS } from './checkout-status';

export interface Props {
  locale: Locale;
  token: string;
  environment: string;
}

const RETURN_URL = 'pseudolearn://agent/purchase';

const { locale, token, environment } = Astro.props;
const { t } = useTranslations(locale);
const messages = Object.entries(STATUS_KEYS);
---

<section
  class="pl-container paddle-checkout"
  data-paddle-checkout
  data-paddle-token={token}
  data-paddle-environment={environment}
>
  <div role="status" aria-live="polite">
    {messages.map(([status, key]) => (
      <p class="paddle-checkout__message" data-checkout-message={status} hidden={status !== 'loading'}>
        {t(key)}
      </p>
    ))}
  </div>
  <a class="pl-btn pl-btn--primary" href={RETURN_URL} data-checkout-return hidden>
    {t('checkout.returnToApp')}
  </a>
</section>

<script>
  import { attachPaddleCheckout } from './paddle-checkout-client';

  attachPaddleCheckout(document);
</script>

<style>
  .paddle-checkout {
    display: grid;
    gap: var(--pl-space-lg);
    padding-top: var(--pl-space-2xl);
    padding-bottom: var(--pl-space-4xl);
    justify-items: start;
  }

  .paddle-checkout__message {
    margin: 0;
  }
</style>
