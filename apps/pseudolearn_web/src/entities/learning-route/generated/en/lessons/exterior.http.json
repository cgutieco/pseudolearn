ns":[["PriceMessage","identifier"]]},{"type":"text","text":" are pure functions: they receive numbers or text and give back a value. "},{"type":"code","tokens":[["RequestRate","identifier"]]},{"type":"text","text":" is the edge: it asks for the network, sends the request and checks the status code. With the same program and a service that is down:"}]},{"type":"program","id":"cambio-caido","title":"The service does not answer","source":"Function pesos <- PriceInPesos(dollars As Integer, rate As Integer)\n  Define pesos As Integer;\n  pesos <- dollars * rate;\nEndFunction\n\nFunction message <- PriceMessage(body As String)\n  Define message As String <- \"The response has no rate\";\n  Switch parseJson(body) Do\n    Success(data):\n      Switch data.field(\"dollar\") Do\n        Some(dollar):\n          Switch dollar.asInteger() Do\n            Some(rate): message <- \"Imported fruit: \" + toText(PriceInPesos(2, rate)) + \" pesos\";\n            None: message <- \"The rate is not a number\";\n          EndSwitch\n        None: message <- \"The response has no rate\";\n      EndSwitch\n    Failure(report): message <- \"Badly written response at column \" + toText(report.jsonColumn);\n  EndSwitch\nEndFunction\n\nSubroutine RequestRate() As Result<String, IoError>\n  Define network As NetworkCap <- Propagate requestNetwork();\n  Define response As HttpResponse <- Propagate network.send(HttpRequest(HttpMethod.GET, \"https://cambio.test/hoy\"));\n  If response.status() <> 200 Then\n    Return Success(\"Service unavailable (\" + toText(response.status()) + \")\");\n  EndIf\n  Define body As String <- Propagate response.textBody();\n  Return Success(PriceMessage(body));\nEndSubroutine\n\nAlgorithm ImportedFruit\n  Switch RequestRate() Do\n    Success(message): Write message;\n    Failure(report): Write \"No network: \", report.code;\n  EndSwitch\nEndAlgorithm\n","lines":[[["Function","keywordProcedural"],[" "],["pesos","identifier"],[" "],["<-","operator"],[" "],["PriceInPesos","identifier"],["(","punctuation"],["dollars","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[",","punctuation"],[" "],["rate","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[")","punctuation"]],[["  "],["Define","keywordStructured"],[" "],["pesos","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[";","punctuation"]],[["  "],["pesos","identifier"],[" "],["<-","operator"],[" "],["dollars","identifier"],[" "],["*","operator"],[" "],["rate","identifier"],[";","punctuation"]],[["EndFunction","keywordProcedural"]],[],[["Function","keywordProcedural"],[" "],["message","identifier"],[" "],["<-","operator"],[" "],["PriceMessage","identifier"],["(","punctuation"],["body","identifier"],[" "],["As","punctuation"],[" "],["String","type"],[")","punctuation"]],[["  "],["Define","keywordStructured"],[" "],["message","identifier"],[" "],["As","punctuation"],[" "],["String","type"],[" "],["<-","operator"],[" "],["\"The response has no rate\"","literalString"],[";","punctuation"]],[["  "],["Switch","keywordStructured"],[" "],["parseJson","identifier"],["(","punctuation"],["body","identifier"],[")","punctuation"],[" "],["Do","keywordStructured"]],[["    "],["Success","literalBoolean"],["(","punctuation"],["data","identifier"],[")","punctuation"],[":","punctuation"]],[["      "],["Switch","keywordStructured"],[" "],["data","identifier"],[".","punctuation"],["field","identifier"],["(","punctuation"],["\"dollar\"","literalString"],[")","punctuation"],[" "],["Do","keywordStructured"]],[["        "],["Some","literalBoolean"],["(","punctuation"],["dollar","identifier"],[")","punctuation"],[":","punctuation"]],[["          "],["Switch","keywordStructured"],[" "],["dollar","identifier"],[".","punctuation"],["asInteger","identifier"],["(","punctuation"],[")","punctuation"],[" "],["Do","keywordStructured"]],[["            "],["Some","literalBoolean"],["(","punctuation"],["rate","identifier"],[")","punctuation"],[":","punctuation"],[" "],