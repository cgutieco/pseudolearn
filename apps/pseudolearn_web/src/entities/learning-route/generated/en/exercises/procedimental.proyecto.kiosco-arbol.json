{"id":"procedimental.proyecto.kiosco-arbol","lesson":"procedimental.proyecto","kind":"clasificar","level":"arbol","required":true,"title":[{"type":"text","text":"The till tree"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"The decomposition tree of the till has three branches: read and check the sale, register the sale and close the day. Place each job in its branch."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"Each branch can be written and tested separately: the checks do not need to know how the receipt is printed, and the closing does not need to know how each sale was read."}]}],"evaluation":{"type":"classify","categories":["Read and check the sale","Register the sale","Close the day"],"elements":[{"runs":[{"type":"text","text":"Read the code and the amount."}],"category":0},{"runs":[{"type":"text","text":"Check the code, the amount and the stock."}],"category":0},{"runs":[{"type":"text","text":"Compute the price."}],"category":1},{"runs":[{"type":"text","text":"Take off the stock."}],"category":1},{"runs":[{"type":"text","text":"Write the receipt line."}],"category":1},{"runs":[{"type":"text","text":"Compute the discount."}],"category":2},{"runs":[{"type":"text","text":"Write the total."}],"category":2},{"runs":[{"type":"text","text":"Write the final stock."}],"category":2}]}}
