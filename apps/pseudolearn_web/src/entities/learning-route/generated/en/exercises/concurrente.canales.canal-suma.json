{"id":"concurrente.canales.canal-suma","lesson":"concurrente.canales","kind":"predecir","level":"semilla","required":true,"title":[{"type":"text","text":"The sum that arrives in parts"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Without running it, write exactly what this program shows."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"The producer sends 4, 5 and 6 and closes. The consumer adds each message and, when "},{"type":"code","tokens":[["Receive","identifier"]]},{"type":"text","text":" gives "},{"type":"code","tokens":[["None","literalBoolean"]]},{"type":"text","text":", it leaves the loop and writes 15."}]}],"program":{"id":"prediccion","title":"","source":"Subroutine Suspendable Produce(queue As Channel<Integer>)\n  For number <- 4 To 6 Do\n    Define accepted As Boolean <- Await queue.send(number);\n    If Not accepted Then\n      Write \"channel closed\";\n    EndIf\n  EndFor\n  queue.close();\nEndSubroutine\n\nSubroutine Suspendable AddUp(queue As Channel<Integer>)\n  Define total As Integer <- 0;\n  Repeat\n    Switch Await queue.receive() Do\n      Some(number): total <- total + number;\n      None: Break;\n    EndSwitch\n  Until False\n  Write total;\nEndSubroutine\n\nAlgorithm ChannelSum\n  Define queue As Channel<Integer> <- channel(2);\n  Tasks\n    Spawn Produce(queue);\n    Spawn AddUp(queue);\n  EndTasks\nEndAlgorithm\n","lines":[[["Subroutine","keywordProcedural"],[" "],["Suspendable","keywordStructured"],[" "],["Produce","identifier"],["(","punctuation"],["queue","identifier"],[" "],["As","punctuation"],[" "],["Channel","type"],["<","operator"],["Integer","type"],[">","operator"],[")","punctuation"]],[["  "],["For","keywordStructured"],[" "],["number","identifier"],[" "],["<-","operator"],[" "],["4","literalNumber"],[" "],["To","keywordStructured"],[" "],["6","literalNumber"],[" "],["Do","keywordStructured"]],[["    "],["Define","keywordStructured"],[" "],["a