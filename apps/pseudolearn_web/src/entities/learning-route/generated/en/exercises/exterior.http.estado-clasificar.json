{"id":"exterior.http.estado-clasificar","lesson":"exterior.http","kind":"clasificar","level":"semilla","required":true,"title":[{"type":"text","text":"Fine or with problems?"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Place each code that an answer can bring: did it go fine or was there a problem?"}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"The codes from 200 to 299 say the request went fine; 201 also warns that something was created. 404 says that what was asked for does not exist and 503, that the service is not available."}]}],"evaluation":{"type":"classify","categories":["It went fine","There was a problem"],"elements":[{"runs":[{"type":"text","text":"200"}],"category":0},{"runs":[{"type":"text","text":"404"}],"category":1},{"runs":[{"type":"text","text":"503"}],"category":1},{"runs":[{"type":"text","text":"201"}],"category":0}]}}
