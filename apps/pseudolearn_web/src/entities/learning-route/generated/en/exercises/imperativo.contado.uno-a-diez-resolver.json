{"id":"imperativo.contado.uno-a-diez-resolver","lesson":"imperativo.contado","kind":"resolver","level":"brote","required":false,"title":[{"type":"text","text":"Until it is in range"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Ask for a number again and again until it is between 1 and 10, both included, and show "},{"type":"code","tokens":[["Accepted","identifier"],[":","punctuation"],[" "]]},{"type":"text","text":" followed by the number."}]}],"restriction":[],"hints":[[{"type":"text","text":"How many times do you have to read at least? Do you know how many at most?"}],[{"type":"text","text":"Look at the figure for choosing the way of repeating in "},{"type":"lesson_link","lesson":"imperativo.contado","text":"the lesson"},{"type":"text","text":"."}],[{"type":"text","text":"The condition to finish combines two comparisons."}],[{"type":"code","tokens":[["Repeat","keywordStructured"]]},{"type":"text","text":" with "},{"type":"code","tokens":[["Read","keywordStructured"],[" "],["n","identifier"],[";","punctuation"]]},{"type":"text","text":" and "},{"type":"code","tokens":[["Until","keywordStructured"],[" "],["n","identifier"],[" "],[">=","operator"],[" "],["1","literalNumber"],[" "],["And","operator"],[" "],["n","identifier"],[" "],["<=","operator"],[" "],["10","literalNumber"]]},{"type":"text","text":". Close with the variant."}]],"variant":[{"type":"paragraph","runs":[{"type":"text","text":"Also show how many attempts were needed. (With 0, 15 and 7: 3 attempts.)"}]}],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"Hidden cases: the edges 10 and 1 and several invalid attempts in a row. Frequent mistake: "},{"type":"code","tokens":[["Or","operator"]]},{"type":"text","text":" instead of "},{"type":"code","tokens":[["And","operator"]]},{"type":"text","text":", which accepts any number."}]}],"evaluation":{"type":"cases","cases":[{"inputs":["0","15","7"],"expected":"Accepted: 7","hidden":false},{"inputs":["3"],"expected":"Accepted: 3","hidden":false},{"inputs":["10"],"expected":"Accepted: 10","hidden":true},{"inputs":["11","1"],"expected":"Accepted: 1","hidden":true},{"inputs":["-5","0","11","5"],"expected":"Accepted: 5","hidden":true}],"assertions":[],"reference":"Algorithm OneToTen\n  Define n As Integer;\n  Repeat\n    Read n;\n  Until n >= 1 And n <= 10\n  Write \"Accepted: \", n;\nEndAlgorithm\n"}}
