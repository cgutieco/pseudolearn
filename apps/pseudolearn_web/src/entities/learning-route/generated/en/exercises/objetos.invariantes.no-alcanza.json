{"id":"objetos.invariantes.no-alcanza","lesson":"objetos.invariantes","kind":"predecir","level":"semilla","required":false,"title":[{"type":"text","text":"When it is not enough"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Without running it, write exactly what this program shows."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"15 is more than the balance: "},{"type":"code","tokens":[["Charge","identifier"]]},{"type":"text","text":" returns false and changes nothing. The balance stays at 10."}]}],"program":{"id":"prediccion","title":"","source":"Class Card\n  Private Define balance As Integer;\n\n  Method Constructor(initial As Integer)\n    This.balance <- 0;\n    If initial > 0 Then\n      This.balance <- initial;\n    EndIf\n  EndMethod\n\n  Method Charge(amount As Integer) As Boolean\n    If amount <= 0 Or amount > This.balance Then\n      Return False;\n    EndIf\n    This.balance <- This.balance - amount;\n    Return True;\n  EndMethod\n\n  Method Load(amount As Integer) As Boolean\n    If amount <= 0 Then\n      Return False;\n    EndIf\n    This.balance <- This.balance + amount;\n    Return True;\n  EndMethod\n\n  Method Balance() As Integer\n    Return This.balance;\n  EndMethod\nEndClass\n\nAlgorithm Canteen\n  Define card As Card <- New Card(10);\n  Write card.Charge(15);\n  Write card.Balance();\nEndAlgorithm\n","lines":[[["Class","keywordOop"],[" "],["Card","identifier"]],[["  "],["Private","keywordOop"],[" "],["Define","keywordStructured"],[" "],["balance","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[";","punctuation"]],[],[["  "],["Method","keywordOop"],[" "],["Constructor","keywordOop"],["(","punctuation"],["initial","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[")","punctuation"]],[["    "],["This","keywordOop"],[".","punctuation"],["balance","identifier"],[" "],["<-","operator"],[" "],["0","literalNumber"],[";","punctuatio