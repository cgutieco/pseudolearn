g","text":"reference"},{"type":"text","text":": two variables can point to the same vector. If it is changed through one of them, the other sees the change, because there are not two vectors but one."}]},{"type":"program","id":"compartido","title":"Two names, a single vector","source":"Algorithm Compartido\n  Define a As Vector<Integer> <- vector();\n  Define b As Vector<Integer> <- a;\n  b.append(5);\n  Write a.length(), \" \", a;\nEndAlgorithm\n","lines":[[["Algorithm","keywordStructured"],[" "],["Compartido","identifier"]],[["  "],["Define","keywordStructured"],[" "],["a","identifier"],[" "],["As","punctuation"],[" "],["Vector","type"],["<","operator"],["Integer","type"],[">","operator"],[" "],["<-","operator"],[" "],["vector","type"],["(","punctuation"],[")","punctuation"],[";","punctuation"]],[["  "],["Define","keywordStructured"],[" "],["b","identifier"],[" "],["As","punctuation"],[" "],["Vector","type"],["<","operator"],["Integer","type"],[">","operator"],[" "],["<-","operator"],[" "],["a","identifier"],[";","punctuation"]],[["  "],["b","identifier"],[".","punctuation"],["append","identifier"],["(","punctuation"],["5","literalNumber"],[")","punctuation"],[";","punctuation"]],[["  "],["Write","keywordStructured"],[" "],["a","identifier"],[".","punctuation"],["length","identifier"],["(","punctuation"],[")","punctuation"],[",","punctuation"],[" "],["\" \"","literalString"],[",","punctuation"],[" "],["a","identifier"],[";","punctuation"]],[["EndAlgorithm","keywordStructured"]]],"executed":true,"output":"1 [5]\n","termination":"completed","diagnostics":[]},{"type":"paragraph","runs":[{"type":"text","text":"To get an independent copy, use "},{"type":"code","tokens":[["copy","identifier"]]},{"type":"text","text":"."}]},{"type":"heading","id":"metodos","number":"3.5.4","runs":[{"type":"text","text":"Methods"}]},{"type":"table","header":[[{"type":"text","text":"Method"}],[{"type":"text","text":"What it does"}]],"rows":[[[{"type":"code","tokens":[["append","identifier"],["(","punctuation"],["x","identifier"],[")","punctuation"]]}],[{"type":"text","text":"Adds at the end"}]],[[{"type":"code","tokens":[["insert","identifier"],["(","punctuation"],["i","identifier"],[",","punctuation"],[" "],["x","identifier"],[")","punctuation"]]}],[{"type":"text","text":"Adds at position "},{"type":"code","tokens":[["i","identifier"]]},{"type":"text","text":" (from 0 to the length)"}]],[[{"type":"code","tokens":[["remove","identifier"],["(","punctuation"],["i","identifier"],[")","punctuation"]]}],[{"type":"text","text":"Takes out position "},{"type":"code","tokens":[["i","identifier"]]}]],[[{"type":"code","tokens":[["length","identifier"],["(","punctuation"],[")","punctuation"]]}],[{"type":"text","text":"How many elements there are"}]],[[{"type":"code","tokens":[["sort","identifier"],["(","punctuation"],[")","punctuation"]]}],[{"type":"text","text":"Sorts from smallest to largest; accepts a comparator"}]],[[{"type":"code","tokens":[["reverse","identifier"],["(","punctuation"],[")","punctuation"]]}],[{"type":"text","text":"Turns the order around"}]],[[{"type":"code","tokens":[["contains","identifier"],["(","punctuation"],["x","identifier"],[")","punctuation"]]}],[{"type":"code","tokens":[["True","literalBoolean"]]},{"type":"text","text":" if "},{"type":"code","tokens":[["x","identifier"]]},{"type":"text","text":" is there"}]],[[{"type":"code","tokens":[["indexOf","identifier"],["(","punctuation"],["x","identifier"],[")","punctuation"]]}],[{"type":"code","tokens":[["Some","literalBoolean"],["(","punctuation"],["position","identifier"],[")","punctuation"]]},{"type":"text","text":" or "},{"type":"code","tokens":[["None","literalBoolean"]]}]]]},{"type":"callout","kind":"limit","collapsible":false,"blocks":[{"type":"list","ordered":false,"entries":[[{"type":"text","text":"Positions: from 0 to "},{"type":"code","tokens":[["length","identifier"],["(","punctuation"],[")","punctuation"],[" "],["-","operator"],[" "],["1","literalNumber"]]},{"type":"text","text":". "},{"type":"code","tokens":[["insert","identifier"]]},{"type":"text","text":" also accepts "},{"type":"code","tokens":[["length","identifier"],["(","punctuation"],[")","punctuation"]]},{"type":"text","text":" (at the end)."}],[{"type":"text","text":"The natural order of "},{"type":"code","tokens":[["sort","identifier"]]},{"type":"text","text":" works for "},{"type":"code","tokens":[["Integer","type"]]},{"type":"text","text":", "},{"type":"code","tokens":[["Real","type"]]},{"type":"text","text":", "},{"type":"code","tokens":[["Character","type"]]},{"type":"text","text":", "},{"type":"code","tokens":[["String","type"]]},{"type":"text","text":" and "},{"type":"code","tokens":[["Boolean","type"]]},{"type":"text","text":" ("},{"type":"code","tokens":[["False","literalBoolean"]]},{"type":"text","text":" before "},{"type":"code","tokens":[["True","literalBoolean"]]},{"type":"text","text":"); it is stable."}],[{"type":"text","text":"The maximum size is set by the engine's memory budget; exceeding it produces "},{"type":"code","tokens":[["collectionLimitExceeded","identifier"]]},{"type":"text","text":"."}],[{"type":"code","tokens":[["Write","keywordStructured"]]},{"type":"text","text":" shows the elements between brackets separated by comma and space, with strings in quotes."}]]}]},{"type":"callout","kind":"errors","collapsible":false,"blocks":[{"type":"paragraph","runs":[{"type":"text","text":"Reading or removing a position that does not exist stops the program:"}]},{"type":"program","id":"vacio","title":"Removing from an empty vector","source":"Algorithm Vacio\n  Define v As Vector<Integer> <- vector();\n  v.remove(0);\nEndAlgorithm\n","lines":[[["Algorithm","keywordStructured"],[" "],["Vacio","identifier"]],[["  "],["Define","keywordStructured"],[" "],["v","identifier"],[" "],["As","punctuation"],[" "],["Vector","type"],["<","operator"],["Integer","type"],[">","operator"],[" "],["<-","operator"],[" "],["vector","type"],["(","punctuation"],[")","punctuation"],[";","p