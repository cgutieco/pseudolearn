h time it fills up, so appending at the end is cheap almost always. Every structural change increments an internal version that makes it possible to detect whether someone modifies it while it is being iterated."}]},{"type":"intermediate","program":"compartido","lines":["module Compartido en","class \"$vector<integer>\" { \"$leaf:value\": i64 }","func suspendible @main() -> unit {","b0() mass 4:","  stmt.enter @2:3-2:42","  %0 = collection.new obj<\"$vector<integer>\"> @2:34-2:42","  stmt.exit @2:3-2:42","  stmt.enter @3:3-3:35","  %1 = value.require %0 @3:3-3:35","  stmt.exit @3:3-3:35","  stmt.enter @4:3-4:14","  %2 = const.i64 5 @4:12-4:13","  %3 = collection.length %1 @4:3-4:14","  collection.insert %1, %3, %2 @4:3-4:14","  stmt.exit @4:3-4:14","  stmt.enter @5:3-5:27","  %4 = collection.length %0 @5:9-5:19","  %5 = const.char ' ' @5:21-5:24","  %6 = const.str \"[\" @5:26-5:27","  %7 = const.i64 0","  jump b1(%7, %6)","b1(%8: i64, %9: str) mass 0:","  %10 = collection.length %0 @5:26-5:27","  %11 = int.cmp lt, %8, %10","  branch %11, b2(), b3()","b2() mass 0:","  %12 = int.cmp eq, %8, %7","  branch %12, b4(), b5()","b3() mass 0:","  %13 = const.str \"]\" @5:26-5:27","  %14 = text.concat %9, %13 @5:26-5:27","  out.write %4, %5, %14, newline @5:3-5:27","  stmt.exit @5:3-5:27","  return @6:1-6:13","b4() mass 0:","  jump b6(%9)","b5() mass 0:","  %15 = const.str \", \" @5:26-5:27","  %16 = text.concat %9, %15 @5:26-5:27","  jump b6(%16)","b6(%17: str) mass 0:","  %18 = collection.load i64, %0, %8, 0 @5:26-5:27","  %19 = text.format %18 @5:26-5:27","  %20 = text.concat %17, %19 @5:26-5:27","  %21 = const.i64 1","  %22 = int.add %8, %21 @5:26-5:27","  jump b7()","b7() mass 0:","  task.yield_check @1:1-1:21","  jump b1(%22, %20) @1:1-1:21","}"]}]},{"type":"summary","points":[[{"type":"text","text":"A vector grows and shrinks; all its elements have the same type."}],[{"type":"text","text":"Positions from zero; going outside is a failure."}],[{"type":"text","text":"It is