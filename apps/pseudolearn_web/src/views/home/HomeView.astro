---
import BaseLayout from '@app/layouts/BaseLayout.astro';
import { useTranslations } from '@shared/i18n/translator';
import type { Locale } from '@shared/i18n/locales';
import { ROUTES } from '@shared/i18n/routes';
import { routeParts } from '@entities/learning-route/model/route-contents';
import { routeMetrics } from '@entities/learning-route/model/route-metrics';
import HomeHero from '@widgets/home-hero/HomeHero.astro';
import LessonStory from '@widgets/lesson-story/LessonStory.astro';
import ProductTour from '@widgets/product-tour/ProductTour.astro';
import RouteStairs from '@widgets/route-stairs/RouteStairs.astro';
import NodoTeaser from '@widgets/nodo-teaser/NodoTeaser.astro';
import ClosingCta from '@widgets/closing-cta/ClosingCta.astro';

export interface Props {
  locale: Locale;
}

const STORY_ID = 'story';
const { locale } = Astro.props;
const { t } = useTranslations(locale);
const metrics = routeMetrics(routeParts(locale));
---

<BaseLayout
  locale={locale}
  path={ROUTES.home}
  title={t('home.seoTitle')}
  description={t('home.seoDescription', { lessons: metrics.lessons, exercises: metrics.exercises })}
>
  <HomeHero locale={locale} storyId={STORY_ID} />
  <LessonStory locale={locale} id={STORY_ID} />
  <ProductTour locale={locale} />
  <RouteStairs locale={locale} />
  <NodoTeaser locale={locale} />
  <ClosingCta locale={locale} />
</BaseLayout>
