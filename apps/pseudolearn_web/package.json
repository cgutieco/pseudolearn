{
  "name": "pseudolearn-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "astro dev",
    "generate:og-image": "node scripts/generate-og-image.mjs",
    "build": "pnpm generate:og-image && astro build",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,astro}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "astro check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:text": "node scripts/check-hardcoded-text.mjs",
    "check:routes": "node scripts/check-route-parity.mjs",
    "check:comments": "node scripts/check-no-comments.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:plan-constants": "node scripts/check-plan-constants.mjs",
    "check:css-scope": "node scripts/check-css-scope.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:static": "pnpm check:architecture && pnpm check:i18n && pnpm check:text && pnpm check:routes && pnpm check:comments && pnpm check:brand && pnpm check:plan-constants && pnpm check:css-scope && pnpm check:size",
    "check:all": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm check:types && pnpm check:static && pnpm test && pnpm build && pnpm check:budget"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "astro": "^7.4.10",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,astro}": [
      "stylelint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
