subroutine PrintField(document as JsonValue, key as string)
switch document.field(key) do
some(value):
switch value.asText() do
some(content): write content;
none: write "invalid_type";
endSwitch
none: write "missing_field";
endSwitch
endSubroutine
subroutine Fetch() as result<integer, IoError>
define directory as DirCap <- propagate requestDirectory(".");
define file as FileCap <- propagate directory.open("message.txt", "read");
define message as string <- propagate file.readText();
write message;
discard file.close();
define timer as Timer <- propagate requestTimer();
define waited as integer <- propagate timer.wait(1000000000);
define net as NetworkCap <- propagate requestNetwork();
define response as HttpResponse <- propagate net.send(HttpRequest(HttpMethod.GET, "https://rickandmortyapi.com/api/character/1"));
write response.status();
define body as string <- propagate response.textBody();
switch parseJson(body) do
success(document): PrintField(document, "name"); PrintField(document, "status");
failure(problem): write problem.code;
endSwitch
return success(0);
endSubroutine
algorithm Main
switch Fetch() do
success(value):
failure(problem): write problem.code;
endSwitch
endAlgorithm
