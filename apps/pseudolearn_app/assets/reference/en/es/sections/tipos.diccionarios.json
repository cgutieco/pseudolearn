},{"type":"token","token":["(","punctuation"]},{"type":"slot","text":"key"},{"type":"token","token":[")","punctuation"]}]]},{"type":"heading","id":"funciona","number":"3.6.2","runs":[{"type":"text","text":"How it works"}]},{"type":"paragraph","runs":[{"type":"text","text":"Writing "},{"type":"code","tokens":[["d","identifier"],["[","punctuation"],["k","identifier"],["]","punctuation"],[" "],["<-","operator"],[" "],["v","identifier"]]},{"type":"text","text":" stores the value "},{"type":"code","tokens":[["v","identifier"]]},{"type":"text","text":" under the key "},{"type":"code","tokens":[["k","identifier"]]},{"type":"text","text":": if the key did not exist, it is added at the end; if it already existed, its value is replaced without moving it. Reading "},{"type":"code","tokens":[["d","identifier"],["[","punctuation"],["k","identifier"],["]","punctuation"]]},{"type":"text","text":" returns the value of that key. Dictionaries "},{"type":"strong","text":"remember insertion order"},{"type":"text","text":": when written or when their keys are requested, they come out in the order they were added."}]},{"type":"program","id":"edades","title":"An address book of ages","source":"Algoritmo Edades\n  Definir edades Como Diccionario<Cadena, Entero> <- Diccionario();\n  edades[\"Ana\"] <- 12;\n  edades[\"Luis\"] <- 11;\n  edades[\"Ana\"] <- 13;\n  Escribir edades, \" \", edades.Longitud();\n  Escribir edades[\"Ana\"], \" \", edades.Claves();\nFinAlgoritmo\n","lines":[[["Algoritmo","keywordStructured"],[" "],["Edades","identifier"]],[["  "],["Definir","keywordStructured"],[" "],["edades","identifier"],[" "],["Como","punctuation"],[" "],["Diccionario","type"],["<","operator"],["Cadena","type"],[",","punctuation"],[" "],["Entero","type"],[">","operator"],[" "],["<-","operator"],[" "],["Diccionario","type"],["(","punctuation"],[")","punctuation"],[";","punctuation"]],[["  "],["edades","identifier"],["[","punctuation"],["\"Ana\"","literalString"],["]","punctuation"],[" "],["<-","ope