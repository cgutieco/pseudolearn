eta Como DirectorioCap <- Propagar SolicitarDirectorio(\".\");\n  Definir archivo Como ArchivoCap <- Propagar carpeta.Abrir(\"config.txt\", \"lectura\");\n  Retornar archivo.LeerTexto();\nFinSubProceso\n\nAlgoritmo Config\n  Segun LeerConfig() Hacer\n    Exito(texto): Escribir texto;\n    Error(problema): Escribir \"No se pudo leer: \", problema.Codigo;\n  FinSegun\nFinAlgoritmo\n","lines":[[["SubProceso","keywordProcedural"],[" "],["LeerConfig","identifier"],["(","punctuation"],[")","punctuation"],[" "],["Como","punctuation"],[" "],["Resultado","type"],["<","operator"],["Cadena","type"],[",","punctuation"],[" "],["ErrorES","type"],[">","operator"]],[["  "],["Definir","keywordStructured"],[" "],["carpeta","identifier"],[" "],["Como","punctuation"],[" "],["DirectorioCap","type"],[" "],["<-","operator"],[" "],["Propagar","keywordStructured"],[" "],["SolicitarDirectorio","identifier"],["(","punctuation"],["\".\"","literalString"],[")","punctuation"],[";","punctuation"]],[["  "],["Definir","keywordStructured"],[" "],["archivo","identifier"],[" "],["Como","punctuation"],[" "],["ArchivoCap","type"],[" "],["<-","operator"],[" "],["Propagar","keywordStructured"],[" "],["carpeta","identifier"],[".","punctuation"],["Abrir","identifier"],["(","punctuation"],["\"config.txt\"","literalString"],[",","punctuation"],[" "],["\"lectura\"","literalString"],[")","punctuation"],[";","punctuation"]],[["  "],["Retornar","keywordProcedural"],[" "],["archivo","identifier"],[".","punctuation"],["LeerTexto","identifier"],["(","punctuation"],[")","punctuation"],[";","punctuation"]],[["FinSubProceso","keywordProcedural"]],[],[["Algoritmo","keywordStructured"],[" "],["Config","identifier"]],[["  "],["Segun","keywordStructured"],[" "],["LeerConfig","identifier"],["(","punctuation"],[")","punctuation"],[" "],["Hacer","keywordStructured"]],[["    "],["Exito","literalBoolean"],["(","punctuation"],["texto","identifier"],[")","punctuation"],[":","punctuation"],[" "],["Escribir","keywordStructured"],["