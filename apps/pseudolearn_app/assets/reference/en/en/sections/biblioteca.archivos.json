{"id":"biblioteca.archivos","number":"12.7","kind":"concepto","title":[{"type":"text","text":"Files and folders"}],"phrase":[{"type":"text","text":"To read or write files you ask for a folder capability, open the file with it, and every operation returns a "},{"type":"code","tokens":[["Result","type"]]},{"type":"text","text":" that may carry an "},{"type":"code","tokens":[["IoError","type"]]},{"type":"text","text":"."}],"blocks":[{"type":"callout","kind":"phrase","collapsible":false,"blocks":[{"type":"paragraph","runs":[{"type":"text","text":"To read or write files you ask for a folder capability, open the file with it, and every operation returns a "},{"type":"code","tokens":[["Result","type"]]},{"type":"text","text":" that may carry an "},{"type":"code","tokens":[["IoError","type"]]},{"type":"text","text":"."}]}]},{"type":"heading","id":"funciona","number":"12.7.1","runs":[{"type":"text","text":"How it works"}]},{"type":"paragraph","runs":[{"type":"text","text":"The path is always the same:"}]},{"type":"list","ordered":true,"entries":[[{"type":"code","tokens":[["requestDirectory","identifier"],["(","punctuation"],["path","identifier"],[")","punctuation"]]},{"type":"text","text":" gives a "},{"type":"code","tokens":[["DirCap","type"]]},{"type":"text","text":" for that folder."}],[{"type":"code","tokens":[["folder","identifier"],[".","punctuation"],["open","identifier"],["(","punctuation"],["name","identifier"],[",","punctuation"],[" "],["mode","identifier"],[")","punctuation"]]},{"type":"text","text":" gives a "},{"type":"code","tokens":[["FileCap","type"]]},{"type":"text","text":", with mode "},{"type":"code","tokens":[["\"lectura\"","literalString"]]},{"type":"text","text":" or "},{"type":"code","tokens":[["\"escritura\"","literalString"]]},{"type":"text","text":"."}],[{"type":"code","tokens":[["readText","identifier"]]},{"type":"text","text":", "},{"type":"code","tokens":[["writeText","identifier"]]},{"type":"text","text":", "},{"type":"code","tokens":[["appendT