  EndSwitch\nEndAlgorithm\n","lines":[[["Subroutine","keywordProcedural"],[" "],["dividir","identifier"],["(","punctuation"],["a","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[",","punctuation"],[" "],["b","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[")","punctuation"],[" "],["As","punctuation"],[" "],["Result","type"],["<","operator"],["Integer","type"],[",","punctuation"],[" "],["String","type"],[">","operator"]],[["  "],["If","keywordStructured"],[" "],["b","identifier"],[" "],["=","operator"],[" "],["0","literalNumber"],[" "],["Then","keywordStructured"]],[["    "],["Return","keywordProcedural"],[" "],["Failure","literalBoolean"],["(","punctuation"],["\"no se divide entre cero\"","literalString"],[")","punctuation"],[";","punctuation"]],[["  "],["EndIf","keywordStructured"]],[["  "],["Return","keywordProcedural"],[" "],["Success","literalBoolean"],["(","punctuation"],["a","identifier"],[" "],["Div","operator"],[" "],["b","identifier"],[")","punctuation"],[";","punctuation"]],[["EndSubroutine","keywordProcedural"]],[["Algorithm","keywordStructured"],[" "],["Division","identifier"]],[["  "],["Switch","keywordStructured"],[" "],["dividir","identifier"],["(","punctuation"],["10","literalNumber"],[",","punctuation"],[" "],["2","literalNumber"],[")","punctuation"],[" "],["Do","keywordStructured"]],[["    "],["Success","literalBoolean"],["(","punctuation"],["cociente","identifier"],[")","punctuation"],[":","punctuation"],[" "],["Write","keywordStructured"],[" "],["\"Cociente: \"","literalString"],[",","punctuation"],[" "],["cociente","identifier"],[";","punctuation"]],[["    "],["Failure","literalBoolean"],["(","punctuation"],["motivo","identifier"],[")","punctuation"],[":","punctuation"],[" "],["Write","keywordStructured"],[" "],["\"Error: \"","literalString"],[",","punctuation"],[" "],["motivo","identifier"],[";","punctuation"]],[["  "],["EndSwitch","keywordStructured"]],[["  "],["Switch","keywordStructured"],[" "],["dividir