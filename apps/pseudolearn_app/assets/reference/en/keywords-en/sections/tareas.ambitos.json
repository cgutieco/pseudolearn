{"id":"tareas.ambitos","number":"11.2","kind":"construccion","title":[{"type":"text","text":"Task scopes with "},{"type":"code","tokens":[["Tasks","keywordStructured"]]},{"type":"text","text":" and "},{"type":"code","tokens":[["Spawn","keywordStructured"]]}],"phrase":[{"type":"code","tokens":[["Tasks","keywordStructured"]]},{"type":"text","text":" opens a space where tasks that progress together are spawned; "},{"type":"code","tokens":[["EndTasks","keywordStructured"]]},{"type":"text","text":" waits for "},{"type":"strong","text":"all"},{"type":"text","text":" of them to finish, so none is left loose."}],"blocks":[{"type":"callout","kind":"phrase","collapsible":false,"blocks":[{"type":"paragraph","runs":[{"type":"code","tokens":[["Tasks","keywordStructured"]]},{"type":"text","text":" opens a space where tasks that progress together are spawned; "},{"type":"code","tokens":[["EndTasks","keywordStructured"]]},{"type":"text","text":" waits for "},{"type":"strong","text":"all"},{"type":"text","text":" of them to finish, so none is left loose."}]}]},{"type":"heading","id":"escribe","number":"11.2.1","runs":[{"type":"text","text":"How to write it"}]},{"type":"form","lines":[[{"type":"token","token":["Tasks","keywordStructured"]},{"type":"token","token":[" "]},{"type":"optional","text":"⟦"},{"type":"slot","text":"fallo"},{"type":"optional","text":"⟧"}],[{"type":"token","token":["  "]},{"type":"token","token":["Spawn","keywordStructured"]},{"type":"token","token":[" "]},{"type":"slot","text":"Unidad"},{"type":"token","token":["(","punctuation"]},{"type":"slot","text":"argumentos"},{"type":"token","token":[")","punctuation"]},{"type":"token","token":[";","punctuation"]}],[{"type":"token","token":["  "]},{"type":"token","token":["Define","keywordStructured"]},{"type":"token","token":[" "]},{"type":"slot","text":"asa"},{"type":"token","token":[" "]},{"type":"token","token":["As","punctuation"]},{"type":"token","token":[" "]},{"type":"token","token":["Task","type"]},{"type":"token","token":["<","operator"]},{"type":"slot","text":"tipo"},{"type":"token","token":[">","operator"]},{"type":"token","token":[" "]},{"type":"token","token":["<-","operator"]},{"type":"token","token":[" "]},{"type":"token","token":["Spawn","keywordStructured"]},{"type":"token","token":[" "]},{"type":"slot","text":"Unidad"},{"type":"token","token":["(","punctuation"]},{"type":"slot","text":"argumentos"},{"type":"token","token":[")","punctuation"]},{"type":"token","token":[";","punctuation"]}],[{"type":"token","token":["  "]},{"type":"slot","text":"instrucciones"}],[{"type":"token","token":["EndTasks","keywordStructured"]}]]},{"type":"callout","kind":"parts","collapsible":false,"blocks":[{"type":"list","ordered":false,"entries":[[{"type":"code","tokens":[["Tasks","keywordStructured"]]},{"type":"text","text":" opens the scope. "},{"type":"slot","text":"failure"},{"type":"text","text":" is an optional name that, after "},{"type":"code","tokens":[["EndTasks","keywordStructured"]]},{"type":"text","text":", tells whether any task failed."}],[{"type":"code","tokens":[["Spawn","keywordStructured"]]},{"type":"text","text":" creates a child task that runs a "},{"type":"code","tokens":[["Suspendible","identifier"]]},{"type":"text","text":" unit. It is only written directly inside the scope."}],[{"type":"text","text":"A "},{"type":"strong","text":"handle"},{"type":"text","text":" "},{"type":"code","tokens":[["Task","type"],["<","operator"],["T","identifier"],[">","operator"]]},{"type":"text","text":" keeps the spawned task; its only use is "},{"type":"code","tokens":[["Await","keywordStructured"],[" "],["handle","identifier"]]},{"type":"text","text":" to get the result."}],[{"type":"code","tokens":[["EndTasks","keywordStructured"]]},{"type":"text","text":" joins all children: it waits for those still alive."}]]}]},{"type":"heading","id":"funciona","number":"11.2.2","runs":[{"type":"text","text":"How it works"}]},{"type":"paragraph","runs":[{"type":"code","tokens":[["Spawn","keywordStructured"]]},{"type":"text","text":" does not stop the parent: it creates the child and the parent goes on with the next statement. The children run when the parent pauses, at the latest at "},{"type":"code","tokens":[["EndTasks","keywordStructured"]]},{"type":"text","text":"."}]},{"type":"program","id":"lanzar-dos","title":"Two tasks and their join","source":"Subroutine Suspendable Saludar(nombre As String)\n  Write \"Hola, \", nombre;\nEndSubroutine\n\nAlgorithm Orden\n  Tasks\n    Spawn Saludar(\"Ana\");\n    Spawn Saludar(\"Leo\");\n    Write \"lanzadas\";\n  EndTasks\n  Write \"todas terminaron\";\nEndAlgorithm\n","lines":[[["Subroutine","keywordProcedural"],[" "],["Suspendable","keywordStructured"],[" "],["Saludar","identifier"],["(","punctuation"],["nombre","identifier"],[" "],["As","punctuation"],[" "],["String","type"],[")","punctuation"]],[["  "],["Write","keywordStructured"],[" "],["\"Hola, \"","literalString"],[",","punctuation"],[" "],["nombre","identifier"],[";","punctuation"]],[["EndSubroutine","keywordProcedural"]],[],[["Algorithm","keywordStructured"],[" "],["Orden","identifier"]],[["  "],["Tasks","keywordStructured"]],[["    "],["Spawn","keywordStructured"],[" "],["Saludar","identifier"],["(","punctuation"],["\"Ana\"","literalString"],[")","punctuation"],[";","punctuation"]],[["    "],["Spawn","keywordStructured"],[" "],["Saludar","identifier"],["(","punctuation"],["\"Leo\"","literalString"],[")","punctuation"],[";","punctuation"]],[["    "],["Write","keywordStructured"],[" "],["\"lanzadas\"","literalString"],[";","punctuation"]],[["  "],["EndTasks","keywordStructured"]],[["  "],["Write","keywordStructured"],[" "],["\"todas terminaron\"","literalString"],[";","punctuation"]],[["EndAlgorithm","keywordStructured"]]],"executed":true,"output":"lanzadas\nHola, Ana\nHola, Leo\ntodas terminaron\n","termination":"completed","diagnostics":[]},{"type":"figure","id":"ambito-tareas","number":"11.2-1","alt":"A task scope","description":"The parent's line r