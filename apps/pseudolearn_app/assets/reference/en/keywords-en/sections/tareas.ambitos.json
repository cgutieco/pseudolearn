 task.cancel_point b2()","  task.scope_boundary %0, b3()","  task.scope_join %0 @6:3-10:11","  jump b1() @6:3-10:11","b1() mass 1:","  stmt.enter @11:3-11:27","  %6 = const.str \"todas terminaron\" @11:9-11:27","  out.write %6, newline @11:3-11:27","  stmt.exit @11:3-11:27","  return @12:1-12:13","b2() mass 0:","  task.scope_join %0 @6:3-10:11","  return @6:3-10:11","b3() mass 0:","  task.scope_join %0 @6:3-10:11","  jump b1()","}","func suspendible @task:Saludar(%0: str) -> unit {","b0() mass 0:","  %1 = call @Saludar(%0) @1:1-1:49","  task.outcome success @1:1-1:49","  return @1:1-1:49","}"]}]},{"type":"summary","points":[[{"type":"code","tokens":[["Tasks","keywordStructured"]]},{"type":"text","text":" opens a scope and "},{"type":"code","tokens":[["EndTasks","keywordStructured"]]},{"type":"text","text":" waits for all its children."}],[{"type":"code","tokens":[["Spawn","keywordStructured"]]},{"type":"text","text":" creates a child without stopping the parent."}],[{"type":"text","text":"A handle is only used with "},{"type":"code","tokens":[["Await","keywordStructured"]]},{"type":"text","text":"."}],[{"type":"text","text":"The first error cancels the siblings and is kept in the failure name."}]]},{"type":"see_also","links":[{"section":"tareas.suspendible","number":"11.1","title":"Suspendible units and Await"},{"section":"tareas.canales","number":"11.3","title":"Channels and Select"},{"section":"tipos.inmutable","number":"3.13","title":"immutable and snapshot"}]}]}
