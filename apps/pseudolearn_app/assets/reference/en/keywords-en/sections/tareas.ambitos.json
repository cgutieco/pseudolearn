\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><polygon points=\"46,152 54,147.5 54,156.5\" fill=\"#FF0004\"/><polyline points=\"200,128 200,152 136,152\" fill=\"none\" stroke=\"#FF0004\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><polygon points=\"128,152 136,147.5 136,156.5\" fill=\"#FF0004\"/><rect x=\"20\" y=\"156\" width=\"300\" height=\"2\" fill=\"#FF0004\"></rect><text x=\"250\" y=\"172\" font-size=\"12\" fill=\"#FF0004\" font-family=\"IBMPlexSans\">EndTasks</text><text x=\"58\" y=\"186\" font-size=\"12\" fill=\"#FF0009\" font-family=\"IBMPlexSans\">all joined</text></svg>","layers":[],"steps":[],"panels":[]},{"type":"paragraph","runs":[{"type":"text","text":"A handle gets a child's value back:"}]},{"type":"program","id":"asas","title":"Waiting for results","source":"Subroutine Suspendable Cuadrado(n As Integer) As Integer\n  Return n * n;\nEndSubroutine\n\nAlgorithm Paralelo\n  Tasks\n    Define a As Task<Integer> <- Spawn Cuadrado(3);\n    Define b As Task<Integer> <- Spawn Cuadrado(4);\n    Write Await a + Await b;\n  EndTasks\nEndAlgorithm\n","lines":[[["Subroutine","keywordProcedural"],[" "],["Suspendable","keywordStructured"],[" "],["Cuadrado","identifier"],["(","punctuation"],["n","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[")","punctuation"],[" "],["As","punctuation"],[" "],["Integer","type"]],[["  "],["Return","keywordProcedural"],[" "],["n","identifier"],[" "],["*","operator"],[" "],["n","identifier"],[";","punctuation"]],[["EndSubroutine","keywordProcedural"]],[],[["Algorithm","keywordStructured"],[" "],["Paralelo","identifier"]],[["  "],["Tasks","keywordStructured"]],[["    "],["Define","keywordStructured"],[" "],["a","identifier"],[" "],["As","punctuation"],[" "],["Task","type"],["<","operator"],["Integer","type"],[">","operator"],[" "],["<-","operator"],[" "],["Spawn","keywordStructured"],[" "],["Cuadrado","identifier"],["(","punctuation"],["3","literalNumber"],[")","punctuation"],[";","punctuation"]],[["    "],["Define","keywordStructured"],[" "],["b","identifier"],[" "],["As","punctuation"],[" "],["Task","type"],["<","operator"],["Integer","type"],[">","operator"],[" "],["<-","operator"],[" "],["Spawn","keywordStructured"],[" "],["Cuadrado","identifier"],["(","punctuation"],["4","literalNumber"],[")","punctuation"],[";","punctuation"]],[["    "],["Write","keywordStructured"],[" "],["Await","keywordStructured"],[" "],["a","identifier"],[" "],["+","operator"],[" "],["Await","keywordStructured"],[" "],["b","identifier"],[";","punctuation"]],[["  "],["EndTasks","keywordStructured"]],[["EndAlgorithm","keywordStructured"]]],"executed":true,"output":"25\n","termination":"completed","diagnostics":[]},{"type":"heading","id":"fallos","number":"11.2.3","runs":[{"type":"text","text":"Failures"}]},{"type":"paragraph","runs":[{"type":"text","text":"If the children return "},{"type":"code","tokens":[["Result","type"],["<","operator"],["T","identifier"],[",","punctuation"],[" "],["E","identifier"],[">","operator"]]},{"type":"text","text":", the first "},{"type":"code","tokens":[["Error","identifier"]]},{"type":"text","text":" to finish "},{"type":"strong","text":"cancels"},{"type":"text","text":" the others and jumps to "},{"type":"code","tokens":[["EndTasks","keywordStructured"]]},{"type":"text","text":". The scope's failure name is an "},{"type":"code","tokens":[["Optional","type"],["<","operator"],["TaskFailure","type"],["<","operator"],["E","identifier"],[">","operator"],[">","operator"]]},{"type":"text","text":": it is "},{"type":"code","tokens":[["Nothing","identifier"]]},{"type":"text","text":" if all went well, or "},{"type":"code","tokens":[["Something","identifier"]]},{"type":"text","text":" with a "},{"type":"code","tokens":[["TaskFailure","type"]]},{"type":"text","text":" whose fields are "},{"type":"code","tokens":[["f","identifier"],[".","punctuation"],["first","identifier"]]},{"type":"text","text":" (the first error), "},{"type":"code","tokens":[["f","identifier"],[".","punctuation"],["associated","identifier"]]},{"type":"text","text":" (the errors that arrived later) and "},{"type":"code","tokens":[["f","identifier"],[".","punctuation"],["cancelled","identifier"]]},{"type":"text","text":" (how many children were cancelled)."}]},{"type":"program","id":"fallo-tareas","title":"The first error rules","source":"Subroutine Suspendable Dividir(a As Integer, b As Integer) As Result<Integer, String>\n  If b = 0 Then\n    Return Failure(\"división entre cero\");\n  EndIf\n  Return Success(a Div b);\nEndSubroutine\n\nAlgorithm Fallos\n  Tasks fallo\n    Spawn Dividir(10, 2);\n    Spawn Dividir(1, 0);\n  EndTasks\n  Switch fallo Do\n    Some(f):\n      Write \"primer error: \", f.first;\n    None:\n      Write \"todo bien\";\n  EndSwitch\nEndAlgorithm\n","lines":[[["Subroutine","keywordProcedural"],[" "],["Suspendable","keywordStructured"],[" "],["Dividir","identifier"],["(","punctuation"],["a","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[",","punctuation"],[" "],["b","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[")","punctuation"],[" "],["As","punctuation"],[" "],["Result","type"],["<","operator"],["Integer","type"],[",","punctuation"],[" "],["String","type"],[">","operator"]],[["  "],["If","keywordStructured"],[" "],["b","identifier"],[" "],["=","operator"],[" "],["0","literalNumber"],[" "],["Then","keywordStructured"]],[["    "],["Return","keywordProcedural"],[" "],["Failure","literalBoolean"],["(","punctuation"],["\"división entre cero\"","literalString"],[")","punctuation"],[";","punctuation"]],[["  "],["EndIf","keywordStructured"]],[["  "],["Return","keywordProcedural"],[" "],["Success","literalBoolean"],["(","punctuation"],["a","identifier"],[" "],["Div","operator"],[" "],["b","identifier"],[")","punctuation"],[";","punctuation"]],[["EndSubroutine","keywordProcedural"]],[],[["Algorithm","keywordStructured"],[" "],["Fallos","identifier"]],[["  "],["Tasks","keywordStructured"],[" "],["fallo","identifier"]],[["    "],["Spawn","keywordStructured"],[" "],["Dividir","identifier"],["(","punctuation"],["10","literalNumber"],[",","punctuation"],[" "],["2","literalNumber"],[")","punctuation"],[";","punctuation"]],[["    "],["Spawn","keywordStructured"],[" "],["Dividir","identifier"],["(","punctuation"],["1","literalNumber"],[",","punctuation"],[" "],["0","literalNumber"],[")","punctuation"],[";","punctuation"]],[["  "],["EndTasks","keywordStructured"]],[["  "],["Switch","keywordStructured"],[" "],["fallo","identifier"],[" "],["Do","keywordStructured"]],[["    "],["Some","literalBoolean"],["(","punctuation"],["f","identifier"],[")","punctuation"],[":","punctuation"]],[["      "],["Write","keywordStructured"],[" "],["\"primer error: \"","literalString"],[",","punctuation"],[" "],["f","identifier"],[".","punctuation"],["first","identifier"],[";","punctuation"]],[["    "],["None","literalBoolean"],[":","punctuation"]],[["      "],["Write","keywordStructured"],[" "],["\"todo bien\"","literalString"],[";","punctuation"]],[["  "],["EndSwitch","keywordStructured"]],[["EndAlgorithm","keywordStructured"]]],"executed":true,"output":"primer error: división entre cero\n","termination":"completed","diagnostics":[]},{"type":"callout","kind":"limit","collapsible":false,"blocks":[{"type":"list","ordered":false,"entries":[[{"type":"code","tokens":[["Spawn","keywordStructured"]]},{"type":"text","text":" arguments must be "},{"type":"strong","text":"transferable"},{"type":"text","text":" and cannot go by reference: tasks share no mutable memory."}],[{"type":"text","text":"A handle cannot leave the scope: assigning, passing or returning it is "},{"type":"code","tokens":[["taskHandleEscape","identifier"]]},{"type":"text","text":"."}],[{"type":"text","text":"A trap in any task ends "},{"type":"strong","text":"the whole"},{"type":"text","text":" run, without cleanups."}]]}]},{"type":"callout","kind":"errors","collapsible":false,"blocks":[{"type":"program","