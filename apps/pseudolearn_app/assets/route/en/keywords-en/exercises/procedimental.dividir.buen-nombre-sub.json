{"id":"procedimental.dividir.buen-nombre-sub","lesson":"procedimental.dividir","kind":"explicar","level":"semilla","required":false,"title":[{"type":"text","text":"The name of the piece"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"What should the piece of program that says whether a year is a leap year be called?"}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"A good name says what it does or what it answers. If the piece answers yes or no, its name should read like a question."}]}],"evaluation":{"type":"choice","options":[{"runs":[{"type":"code","tokens":[["Calculate","identifier"]]}],"justification":[{"type":"text","text":"It does not say what it computes: every piece computes something."}],"correct":false},{"runs":[{"type":"code","tokens":[["LeapYear","identifier"]]}],"justification":[{"type":"text","text":"It names the topic, but does not say what it answers."}],"correct":false},{"runs":[{"type":"code","tokens":[["IsLeapYear","identifier"]]}],"justification":[{"type":"text","text":"It reads like a question, "},{"type":"slot","text":"is it a leap year?"},{"type":"text","text":": "},{"type":"code","tokens":[["IsLeapYear","identifier"],["(","punctuation"],["2024","literalNumber"],[")","punctuation"]]},{"type":"text","text":" answers yes or no."}],"correct":true},{"runs":[{"type":"code","tokens":[["DoIt","identifier"]]}],"justification":[{"type":"text","text":"It says nothing about the problem."}],"correct":false}]}}
