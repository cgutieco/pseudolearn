{"id":"objetos.invariantes.no-alcanza","lesson":"objetos.invariantes","kind":"predecir","level":"semilla","required":false,"title":[{"type":"text","text":"When it is not enough"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Without running it, write exactly what this program shows."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"15 is more than the balance: "},{"type":"code","tokens":[["Cobrar","identifier"]]},{"type":"text","text":" returns false and changes nothing. The balance stays at 10."}]}],"teachers":[],"program":{"id":"prediccion","title":"","source":"Class Tarjeta\n  Private Define saldo As Integer;\n\n  Method Constructor(inicial As Integer)\n    This.saldo <- 0;\n    If inicial > 0 Then\n      This.saldo <- inicial;\n    EndIf\n  EndMethod\n\n  Method Cobrar(monto As Integer) As Boolean\n    If monto <= 0 Or monto > This.saldo Then\n      Return False;\n    EndIf\n    This.saldo <- This.saldo - monto;\n    Return True;\n  EndMethod\n\n  Method Cargar(monto As Integer) As Boolean\n    If monto <= 0 Then\n      Return False;\n    EndIf\n    This.saldo <- This.saldo + monto;\n    Return True;\n  EndMethod\n\n  Method Saldo() As Integer\n    Return This.saldo;\n  EndMethod\nEndClass\n\nAlgorithm Comedor\n  Define tarjeta As Tarjeta <- New Tarjeta(10);\n  Write tarjeta.Cobrar(15);\n  Write tarjeta.Saldo();\nEndAlgorithm\n","lines":[[["Class","keywordOop"],[" "],["Tarjeta","identifier"]],[["  "],["Private","keywordOop"],[" "],["Define","keywordStructured"],[" "],["saldo","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[";","punctuation"]],[],[["  "],["Method","keywordOop"],[" "],["Constructor","keywordOop"],["(","punctuation"],["inicial","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[")","punctuation"]],[["    "],["This","keywordOop"],[".","punctuation"],["saldo","identifier"],[" "],["<-","operator"],[" "],["0","literalNumber"],[";","punctu