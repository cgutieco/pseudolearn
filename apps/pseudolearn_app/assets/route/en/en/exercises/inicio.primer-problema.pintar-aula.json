{"id":"inicio.primer-problema.pintar-aula","lesson":"inicio.primer-problema","kind":"resolver","level":"arbol","required":false,"title":[{"type":"text","text":"Painting the classroom"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"The classroom walls add up to 54 square metres. They need two coats of paint. One litre covers 10 square metres and paint is sold in 4-litre tins. How many tins must be bought? The program shows only the number."}]}],"restriction":[],"hints":[[{"type":"text","text":"What does "},{"type":"slot","text":"two coats"},{"type":"text","text":" mean for the surface to cover?"}],[{"type":"text","text":"Plan it in steps, like "},{"type":"lesson_link","lesson":"inicio.primer-problema","text":"the pizzas"},{"type":"text","text":", with one more sum in the middle."}],[{"type":"text","text":"Total surface, then litres, then tins. In which of those steps do you need to round up?"}],[{"type":"code","tokens":[["Write","keywordStructured"],[" "],["ceil","identifier"],["(","punctuation"],["54","literalNumber"],[" "],["*","operator"],[" "],["2","literalNumber"],[" "],["/","operator"],[" "],["10","literalNumber"],[" "],["/","operator"],[" "],["4","literalNumber"],[")","punctuation"],[";","punctuation"]]},{"type":"text","text":" shows 3. Close with the variant."}]],"variant":[{"type":"paragraph","runs":[{"type":"text","text":"How many litres of paint are left after painting? (Answer: 1.2.)"}]}],"explanation":[],"teachers":[{"type":"paragraph","runs":[{"type":"text","text":"Solution: 108 square metres, 10.8 litres, 2.7 tins, so 3 are bought. Frequent mistake: rounding the litres before dividing by 4, which also gives 3 here but fails with other sizes."}]}],"program":{"id":"inicial","title":"","source":"Algorithm Pintura\nEndAlgorithm\n","lines":[[["Algorithm","keywordStructured"],[" "],["Pintura","identifier"]],[["EndAlgorithm","keywordStructured"]]],"executed":false,"output":"","termination":"","diagnostics":[]},"starter_code":"Algorithm Pintura\nEndAlgorithm\n","evaluation":{"type":"cases","cases":[{"inputs":[],"expected":"3","hidden":false}],"assertions":[],"reference":"Algorithm Pintura\n  Write ceil(54 * 2 / 10 / 4);\nEndAlgorithm\n"}}
