{"id":"procedimental.dividir.area","lesson":"procedimental.dividir","kind":"resolver","level":"semilla","required":true,"title":[{"type":"text","text":"The area of the rectangle"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Read the length and the width of a rectangle and show its area. The program shows only the number."}]}],"restriction":[{"type":"paragraph","runs":[{"type":"text","text":"The calculation goes in a subprogram "},{"type":"code","tokens":[["AreaRectangulo","identifier"]]},{"type":"text","text":" that receives the length and the width."}]}],"hints":[[{"type":"text","text":"Which data does the calculation need? Those are the parameters."}],[{"type":"text","text":"Look at how "},{"type":"code","tokens":[["Doble","identifier"]]},{"type":"text","text":" is written in "},{"type":"lesson_link","lesson":"procedimental.dividir","text":"the lesson"},{"type":"text","text":"."}],[{"type":"text","text":"The subprogram returns the area; the main algorithm reads and shows."}],[{"type":"code","tokens":[["SubProcess","identifier"],[" "],["AreaRectangulo","identifier"],["(","punctuation"],["largo","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[",","punctuation"],[" "],["ancho","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[")","punctuation"],[" "],["As","punctuation"],[" "],["Integer","type"]]},{"type":"text","text":" with "},{"type":"code","tokens":[["Return","keywordProcedural"],[" "],["largo","identifier"],[" "],["*","operator"],[" "],["ancho","identifier"],[";","punctuation"]]},{"type":"text","text":". Close with the variant."}]],"variant":[{"type":"paragraph","runs":[{"type":"text","text":"Add a subprogram "},{"type":"code","tokens":[["PerimetroRectangulo","identifier"]]},{"type":"text","text":" and also show the perimeter."}]}],"explanation":[],"teachers":[{"type":"paragraph","runs":[{"type":"text","text":"The assertion checks that "},{"type":"code","tokens":[["AreaRectangulo","identifier"]]},{"type":"