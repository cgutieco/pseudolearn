{"id":"procedimental.ambito.retorno-o-referencia","lesson":"procedimental.ambito","kind":"comparar","level":"brote","required":false,"title":[{"type":"text","text":"How to give back the double?"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"You have to write a piece that computes the double of a price. How should it give back the result?"}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"With a single result, returning keeps the change in view of whoever reads the program. Lending the box suits when more than one value has to come back."}]}],"evaluation":{"type":"choice","options":[{"runs":[{"type":"text","text":"Return the double, and let whoever calls keep it."}],"justification":[{"type":"text","text":"Whoever reads "},{"type":"code","tokens":[["price","identifier"],[" "],["<-","operator"],[" "],["Double","identifier"],["(","punctuation"],["price","identifier"],[")","punctuation"],[";","punctuation"]]},{"type":"text","text":" sees that the price changes."}],"correct":true},{"runs":[{"type":"text","text":"Receive the price by reference and change it inside."}],"justification":[{"type":"text","text":"It works, but the call "},{"type":"code","tokens":[["Double","identifier"],["(","punctuation"],["price","identifier"],[")","punctuation"],[";","punctuation"]]},{"type":"text","text":" hides that the price changes."}],"correct":false},{"runs":[{"type":"text","text":"Show the double with "},{"type":"code","tokens":[["Write","keywordStructured"]]},{"type":"text","text":" inside the piece."}],"justification":[{"type":"text","text":"That way the result cannot be used in another sum."}],"correct":false}]}}
