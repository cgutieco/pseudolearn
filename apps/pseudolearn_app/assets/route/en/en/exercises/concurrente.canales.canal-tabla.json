{"id":"concurrente.canales.canal-tabla","lesson":"concurrente.canales","kind":"rastrear","level":"brote","required":false,"title":[{"type":"text","text":"Trace the consumer"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Complete the table of the task that adds: the message received and the total, one row per message."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"Each message is added to the total: 4, then 4 + 5 = 9 and finally 9 + 6 = 15. The messages arrive in the order they were sent."}]}],"teachers":[],"program":{"id":"traza","title":"","source":"Subroutine Suspendable Producir(fila As Channel<Integer>)\n  For valor <- 4 To 6 Do\n    Define aceptado As Boolean <- Await fila.send(valor);\n    If Not aceptado Then\n      Write \"canal cerrado\";\n    EndIf\n  EndFor\n  fila.close();\nEndSubroutine\n\nSubroutine Suspendable Sumar(fila As Channel<Integer>)\n  Define total As Integer <- 0;\n  Define valor As Integer <- 0;\n  Repeat\n    Switch Await fila.receive() Do\n      Some(recibido):\n        valor <- recibido;\n        total <- total + valor;\n      None: Break;\n    EndSwitch\n  Until False\n  Write total;\nEndSubroutine\n\nAlgorithm CanalSuma\n  Define fila As Channel<Integer> <- channel(2);\n  Tasks\n    Spawn Producir(fila);\n    Spawn Sumar(fila);\n  EndTasks\nEndAlgorithm\n","lines":[[["Subroutine","keywordProcedural"],[" "],["Suspendable","keywordStructured"],[" "],["Producir","identifier"],["(","punctuation"],["fila","identifier"],[" "],["As","punctuation"],[" "],["Channel","type"],["<","operator"],["Integer","type"],[">","operator"],[")","punctuation"]],[["  "],["For","keywordStructured"],[" "],["valor","identifier"],[" "],["<-","operator"],[" "],["4","literalNumber"],[" "],["To","keywordStructured"],[" "],["6","literalNumber"],[" "],["Do","keywordStructured"]],[["    "],["Define","keywordStructured"],[" "],["aceptado","identifier"],[" "],["As","punctuation"],[" "],["