{"id":"imperativo.caminos.bisiesto-ordenar","lesson":"imperativo.caminos","kind":"ordenar","level":"brote","required":false,"title":[{"type":"text","text":"Ordering the leap year"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"The lines of a program that decides whether a year is a leap year are mixed up. Put them in order so that it works."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"The questions go from the most specific to the most general: 400 first, then 100 and 4 at the end. Each "},{"type":"code","tokens":[["If","keywordStructured"]]},{"type":"text","text":" is closed by its own "},{"type":"code","tokens":[["EndIf","keywordStructured"]]},{"type":"text","text":", from the inside out."}]}],"teachers":[],"evaluation":{"type":"order_program","head":"Algorithm Bisiesto","tail":"EndAlgorithm","blocks":["Else","If anio Mod 100 = 0 Then","Write \"No es bisiesto\";","Else","Define anio As Integer;","Read anio;","If anio Mod 400 = 0 Then","Write \"Es bisiesto\";","If anio Mod 4 = 0 Then","Write \"Es bisiesto\";","EndIf","EndIf","EndIf","Write \"No es bisiesto\";","Else"],"solution":[4,5,6,7,0,1,2,3,8,9,14,13,12,11,10],"cases":[{"inputs":["2024"],"expected":"Es bisiesto","hidden":false},{"inputs":["2023"],"expected":"No es bisiesto","hidden":false},{"inputs":["1900"],"expected":"No es bisiesto","hidden":true},{"inputs":["2000"],"expected":"Es bisiesto","hidden":true}]}}
