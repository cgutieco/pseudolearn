{"id":"imperativo.proyecto.caja-ficha","lesson":"imperativo.proyecto","kind":"clasificar","level":"arbol","required":true,"title":[{"type":"text","text":"The till card"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Place each piece of data from the till problem in its zone of the card."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"What the till writes during break goes in, including the 0, which is not a sale but the signal that they are over. The prices and the discount do not change from one day to the next: they are written in the program. The time of the break changes nothing on the receipt."}]}],"teachers":[],"evaluation":{"type":"classify","categories":["In","Fixed value","Out","Does not matter"],"elements":[{"runs":[{"type":"text","text":"The code of each sale"}],"category":0},{"runs":[{"type":"text","text":"The amount of each sale"}],"category":0},{"runs":[{"type":"text","text":"The 0 that closes the till"}],"category":0},{"runs":[{"type":"text","text":"The prices of the products"}],"category":1},{"runs":[{"type":"text","text":"The discount of 1 peso every 10"}],"category":1},{"runs":[{"type":"text","text":"The lines of the receipt"}],"category":2},{"runs":[{"type":"text","text":"The total and the total with discount"}],"category":2},{"runs":[{"type":"text","text":"The best-selling product"}],"category":2},{"runs":[{"type":"text","text":"The time of the break"}],"category":3}]}}
