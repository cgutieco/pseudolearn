{"id":"imperativo.caminos.bisiesto-ordenar","lesson":"imperativo.caminos","kind":"ordenar","level":"brote","required":false,"title":[{"type":"text","text":"Ordering the leap year"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"The lines of a program that decides whether a year is a leap year are mixed up. Put them in order so that it works."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"The questions go from the most specific to the most general: 400 first, then 100 and 4 at the end. Each "},{"type":"code","tokens":[["Si","keywordStructured"]]},{"type":"text","text":" is closed by its own "},{"type":"code","tokens":[["FinSi","keywordStructured"]]},{"type":"text","text":", from the inside out."}]}],"evaluation":{"type":"order_program","head":"Algoritmo LeapYear","tail":"FinAlgoritmo","blocks":["Sino","Si anio mod 100 = 0 Entonces","Escribir \"Not a leap year\";","Sino","Definir anio Como Entero;","Leer anio;","Si anio mod 400 = 0 Entonces","Escribir \"Leap year\";","Si anio mod 4 = 0 Entonces","Escribir \"Leap year\";","FinSi","FinSi","FinSi","Escribir \"Not a leap year\";","Sino"],"solution":[4,5,6,7,0,1,2,3,8,9,14,13,12,11,10],"cases":[{"inputs":["2024"],"expected":"Leap year","hidden":false},{"inputs":["2023"],"expected":"Not a leap year","hidden":false},{"inputs":["1900"],"expected":"Not a leap year","hidden":true},{"inputs":["2000"],"expected":"Leap year","hidden":true}]}}
