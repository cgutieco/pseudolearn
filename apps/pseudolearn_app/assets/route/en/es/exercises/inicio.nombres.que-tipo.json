{"id":"inicio.nombres.que-tipo","lesson":"inicio.nombres","kind":"clasificar","level":"semilla","required":false,"title":[{"type":"text","text":"Each value in its box"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Place each value in the kind of box that can hold it."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"Numbers without a point go in an "},{"type":"code","tokens":[["Entero","type"]]},{"type":"text","text":" box; with a point, even if they end in "},{"type":"code","tokens":[[".","punctuation"],["0","literalNumber"]]},{"type":"text","text":", in a "},{"type":"code","tokens":[["Real","type"]]},{"type":"text","text":" box. Everything between quotes is a "},{"type":"code","tokens":[["Cadena","type"]]},{"type":"text","text":", even if it has digits inside: "},{"type":"code","tokens":[["\"23\"","literalString"]]},{"type":"text","text":" cannot be multiplied."}]},{"type":"paragraph","runs":[{"type":"text","text":"The trap is "},{"type":"code","tokens":[["\"23\"","literalString"]]},{"type":"text","text":". If you placed it among the numbers, predict what "},{"type":"code","tokens":[["Escribir","keywordStructured"],[" "],["\"23\"","literalString"],[" "],["+","operator"],[" "],["\"1\"","literalString"],[";","punctuation"]]},{"type":"text","text":" shows."}]}],"evaluation":{"type":"classify","categories":["Number without decimals","Number with decimals","Text"],"elements":[{"runs":[{"type":"code","tokens":[["23","literalNumber"]]}],"category":0},{"runs":[{"type":"code","tokens":[["0","literalNumber"]]}],"category":0},{"runs":[{"type":"code","tokens":[["2.5","literalNumber"]]}],"category":1},{"runs":[{"type":"code","tokens":[["8.0","literalNumber"]]}],"category":1},{"runs":[{"type":"code","tokens":[["\"Lucía\"","literalString"]]}],"category":2},{"runs":[{"type":"code","tokens":[["\"23\"","literalString"]]}],"category":2}]}}
