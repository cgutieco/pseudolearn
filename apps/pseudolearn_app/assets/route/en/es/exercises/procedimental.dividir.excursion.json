{"id":"procedimental.dividir.excursion","lesson":"procedimental.dividir","kind":"clasificar","level":"semilla","required":true,"title":[{"type":"text","text":"Organising the school trip"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Organising the class trip can be split into three smaller problems: transport, food and permissions. Place each job in its own."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"Each branch groups jobs that can be solved without thinking about the others: whoever handles transport does not need to know what goes in each sandwich."}]}],"teachers":[],"evaluation":{"type":"classify","categories":["Transport","Food","Permissions"],"elements":[{"runs":[{"type":"text","text":"Hire the bus."}],"category":0},{"runs":[{"type":"text","text":"Set the departure time."}],"category":0},{"runs":[{"type":"text","text":"Buy water."}],"category":1},{"runs":[{"type":"text","text":"Make the sandwiches."}],"category":1},{"runs":[{"type":"text","text":"Collect the signed permission slips."}],"category":2},{"runs":[{"type":"text","text":"Tell the families."}],"category":2}]}}
