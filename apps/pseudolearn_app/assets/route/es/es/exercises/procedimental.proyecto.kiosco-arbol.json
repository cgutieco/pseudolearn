{"id":"procedimental.proyecto.kiosco-arbol","lesson":"procedimental.proyecto","kind":"clasificar","level":"arbol","required":true,"title":[{"type":"text","text":"El árbol de la caja"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"El árbol de descomposición de la caja tiene tres ramas: leer y validar la venta, registrar la venta y cerrar el día. Ubica cada tarea en su rama."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"Cada rama se puede escribir y probar por separado: las validaciones no necesitan saber cómo se imprime el ticket, y el cierre no necesita saber cómo se leyó cada venta."}]}],"teachers":[],"evaluation":{"type":"classify","categories":["Leer y validar la venta","Registrar la venta","Cerrar el día"],"elements":[{"runs":[{"type":"text","text":"Leer el código y la cantidad."}],"category":0},{"runs":[{"type":"text","text":"Comprobar el código, la cantidad y el stock."}],"category":0},{"runs":[{"type":"text","text":"Calcular el importe."}],"category":1},{"runs":[{"type":"text","text":"Descontar el stock."}],"category":1},{"runs":[{"type":"text","text":"Escribir la línea del ticket."}],"category":1},{"runs":[{"type":"text","text":"Calcular el descuento."}],"category":2},{"runs":[{"type":"text","text":"Escribir el total."}],"category":2},{"runs":[{"type":"text","text":"Escribir el stock final."}],"category":2}]}}
