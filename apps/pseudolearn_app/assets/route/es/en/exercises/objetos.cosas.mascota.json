{"id":"objetos.cosas.mascota","lesson":"objetos.cosas","kind":"clasificar","level":"semilla","required":true,"title":[{"type":"text","text":"La mascota virtual"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Una mascota virtual tiene un nombre, energía y hambre; puede comer, jugar y dormir. Ubica cada cosa según sea algo que la mascota sabe o algo que sabe hacer."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"Lo que sabe son sus atributos: datos que cambian con el tiempo. Lo que sabe hacer son sus métodos: comer baja el hambre, jugar gasta energía, dormir la recupera."}]}],"teachers":[],"evaluation":{"type":"classify","categories":["Lo que sabe","Lo que sabe hacer"],"elements":[{"runs":[{"type":"text","text":"su nombre"}],"category":0},{"runs":[{"type":"text","text":"su energía"}],"category":0},{"runs":[{"type":"text","text":"su hambre"}],"category":0},{"runs":[{"type":"text","text":"comer"}],"category":1},{"runs":[{"type":"text","text":"jugar"}],"category":1},{"runs":[{"type":"text","text":"dormir"}],"category":1}]}}
