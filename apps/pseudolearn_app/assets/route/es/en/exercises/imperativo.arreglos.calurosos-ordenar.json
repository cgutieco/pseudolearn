{"id":"imperativo.arreglos.calurosos-ordenar","lesson":"imperativo.arreglos","kind":"ordenar","level":"brote","required":false,"title":[{"type":"text","text":"Ordenar los días calurosos"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Las líneas de un programa que muestra los días más calurosos que el promedio están mezcladas. Ordénalas para que funcione."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"Primero se declara el arreglo y el acumulador; la primera pasada lee y suma; después se calcula el promedio; la segunda pasada compara cada día. El promedio no puede ir antes de la primera pasada."}]}],"teachers":[],"evaluation":{"type":"order_program","head":"Algorithm DiasCalurosos","tail":"EndAlgorithm","blocks":["If temperaturas[i] > promedio Then","Write \"Día \", i;","Define promedio As Real <- suma / 7;","For i <- 0 To 6 Do","suma <- suma + temperaturas[i];","EndFor","For i <- 0 To 6 Do","Read temperaturas[i];","Dimension temperaturas[7] As Integer;","Define suma As Integer <- 0;","EndFor","EndIf"],"solution":[8,9,6,7,4,5,2,3,0,1,11,10],"cases":[{"inputs":["20","23","19","25","22","18","26"],"expected":"Día 1\nDía 3\nDía 4\nDía 6","hidden":false},{"inputs":["10","10","10","10","10","10","30"],"expected":"Día 6","hidden":true},{"inputs":["30","10","10","10","10","10","10"],"expected":"Día 0","hidden":true}]}}
