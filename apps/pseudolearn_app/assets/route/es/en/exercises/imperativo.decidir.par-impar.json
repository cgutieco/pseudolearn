{"id":"imperativo.decidir.par-impar","lesson":"imperativo.decidir","kind":"resolver","level":"semilla","required":true,"title":[{"type":"text","text":"Par o impar"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Lee un número entero y muestra "},{"type":"code","tokens":[["par","identifier"]]},{"type":"text","text":" o "},{"type":"code","tokens":[["impar","identifier"]]},{"type":"text","text":"."}]}],"restriction":[],"hints":[[{"type":"text","text":"Arma la partición: ¿cuáles son las dos regiones? ¿Hay un número que te haga dudar?"}],[{"type":"text","text":"Un número es par si al repartirlo de a 2 no sobra nada. Repasa lo que sobra al repartir en "},{"type":"lesson_link","lesson":"inicio.nombres","text":"la lección 0.2"},{"type":"text","text":"."}],[{"type":"text","text":"La condición compara lo que sobra con 0."}],[{"type":"code","tokens":[["If","keywordStructured"],[" "],["numero","identifier"],[" "],["Mod","operator"],[" "],["2","literalNumber"],[" "],["=","operator"],[" "],["0","literalNumber"],[" "],["Then","keywordStructured"]]},{"type":"text","text":" muestra "},{"type":"code","tokens":[["par","identifier"]]},{"type":"text","text":"; si no, "},{"type":"code","tokens":[["impar","identifier"]]},{"type":"text","text":". Cierra con la variante."}]],"variant":[{"type":"paragraph","runs":[{"type":"text","text":"Muestra "},{"type":"code","tokens":[["múltiplo","identifier"],[" "],["de","identifier"],[" "],["3","literalNumber"]]},{"type":"text","text":" o "},{"type":"code","tokens":[["Not","operator"],[" "],["es","identifier"],[" "],["múltiplo","identifier"],[" "],["de","identifier"],[" "],["3","literalNumber"]]},{"type":"text","text":". (Con 9: múltiplo; con 10: no.)"}]}],"explanation":[],"teachers":[{"type":"paragraph","runs":[{"type":"text","text":"Casos ocultos: 0 es par, 1 es impar y -3 comprueba los negativos. En PseudoLearn, "},{"type":"code","tokens":[["-","operator"],["3","literalNumber"],[" "],["Mod","operator"],[" "],["2","literalNumber"]]},{"type":"text","text":" vale -1, que no es 0: la solución con "},{"type":"code","tokens":[["=","operator"],[" "],["0","literalNumber"]]},{"type":"text","text":" funciona; una con "},{"type":"code","tokens":[["=","operator"],[" "],["1","literalNumber"]]},{"type":"text","text":" falla en -3."}]}],"evaluation":{"type":"cases","cases":[{"inputs":["4"],"expected":"par","hidden":false},{"inputs":["7"],"expected":"impar","hidden":false},{"inputs":["0"],"expected":"par","hidden":true},{"inputs":["1"],"expected":"impar","hidden":true},{"inputs":["-3"],"expected":"impar","hidden":true}],"assertions":[],"reference":"Algorithm ParImpar\n  Define numero As Integer;\n  Read numero;\n  If numero Mod 2 = 0 Then\n    Write \"par\";\n  Else\n    Write \"impar\";\n  EndIf\nEndAlgorithm\n"}}
