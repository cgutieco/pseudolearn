{"id":"funcional.tipos-dominio.posible-o-no","lesson":"funcional.tipos-dominio","kind":"clasificar","level":"semilla","required":true,"title":[{"type":"text","text":"¿Tiene sentido?"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"Con el modelo de cuatro datos sueltos (estado, repartidor, hora y motivo), todos estos pedidos se pueden escribir. Ubica cada uno según tenga sentido o sea imposible en la realidad."}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"Con datos sueltos, los dos últimos se pueden escribir aunque no tengan sentido. Con una variante, no: "},{"type":"code","tokens":[["Entregado","identifier"]]},{"type":"text","text":" exige la hora y "},{"type":"code","tokens":[["Cancelado","identifier"]]},{"type":"text","text":" no tiene lugar para un repartidor."}]}],"teachers":[],"evaluation":{"type":"classify","categories":["Tiene sentido","Es imposible"],"elements":[{"runs":[{"type":"text","text":"Entregado, con hora."}],"category":0},{"runs":[{"type":"text","text":"Cancelado, con motivo."}],"category":0},{"runs":[{"type":"text","text":"Pendiente, sin ningún otro dato."}],"category":0},{"runs":[{"type":"text","text":"Entregado, sin hora."}],"category":1},{"runs":[{"type":"text","text":"Cancelado, con repartidor."}],"category":1}]}}
