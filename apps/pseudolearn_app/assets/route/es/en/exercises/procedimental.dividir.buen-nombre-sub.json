{"id":"procedimental.dividir.buen-nombre-sub","lesson":"procedimental.dividir","kind":"explicar","level":"semilla","required":false,"title":[{"type":"text","text":"El nombre de la pieza"}],"statement":[{"type":"paragraph","runs":[{"type":"text","text":"¿Cómo conviene llamar a la pieza de programa que dice si un año es bisiesto?"}]}],"restriction":[],"hints":[],"variant":[],"explanation":[{"type":"paragraph","runs":[{"type":"text","text":"Un buen nombre dice qué hace o qué responde. Si la pieza responde sí o no, conviene que su nombre se lea como una pregunta."}]}],"teachers":[],"evaluation":{"type":"choice","options":[{"runs":[{"type":"code","tokens":[["Calcular","identifier"]]}],"justification":[{"type":"text","text":"No dice qué calcula: cualquier pieza calcula algo."}],"correct":false},{"runs":[{"type":"code","tokens":[["Bisiesto","identifier"]]}],"justification":[{"type":"text","text":"Nombra el tema, pero no dice qué responde."}],"correct":false},{"runs":[{"type":"code","tokens":[["EsBisiesto","identifier"]]}],"justification":[{"type":"text","text":"Se lee como una pregunta: "},{"type":"code","tokens":[["EsBisiesto","identifier"],["(","punctuation"],["2024","literalNumber"],[")","punctuation"]]},{"type":"text","text":" responde sí o no."}],"correct":true},{"runs":[{"type":"code","tokens":[["Do","keywordStructured"]]}],"justification":[{"type":"text","text":"No dice nada del problema."}],"correct":false}]}}
