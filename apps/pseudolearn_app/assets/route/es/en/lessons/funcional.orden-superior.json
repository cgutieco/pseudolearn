uiente <- x + 1;\nEndFunction\n\nFunction barato <- EsBarato(precio As Integer)\n  Define barato As Boolean;\n  barato <- precio <= 2;\nEndFunction\n\nFunction total <- Sumar(a As Integer, b As Integer)\n  Define total As Integer;\n  total <- a + b;\nEndFunction\n\nFunction nuevos <- Mapear(v As Vector<Integer>, f As Function(Integer) As Integer)\n  Define nuevos As Vector<Integer> <- vector();\n  For Each elemento In v Do\n    nuevos.append(f(elemento));\n  EndFor\nEndFunction\n\nFunction elegidos <- Filtrar(v As Vector<Integer>, condicion As Function(Integer) As Boolean)\n  Define elegidos As Vector<Integer> <- vector();\n  For Each elemento In v Do\n    If condicion(elemento) Then\n      elegidos.append(elemento);\n    EndIf\n  EndFor\nEndFunction\n\nFunction acumulado <- Reducir(v As Vector<Integer>, f As Function(Integer, Integer) As Integer, inicial As Integer)\n  Define acumulado As Integer <- inicial;\n  For Each elemento In v Do\n    acumulado <- f(acumulado, elemento);\n  EndFor\nEndFunction\n\nAlgorithm Precios\n  Define precios As Vector<Integer> <- vector();\n  precios.append(3);\n  precios.append(5);\n  precios.append(2);\n  precios.append(1);\n  precios.append(2);\n  Write Mapear(precios, MasUno);\n  Write Filtrar(precios, EsBarato);\n  Write Reducir(precios, Sumar, 0);\nEndAlgorithm\n","lines":[[["Function","keywordProcedural"],[" "],["siguiente","identifier"],[" "],["<-","operator"],[" "],["MasUno","identifier"],["(","punctuation"],["x","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[")","punctuation"]],[["  "],["Define","keywordStructured"],[" "],["siguiente","identifier"],[" "],["As","punctuation"],[" "],["Integer","type"],[";","punctuation"]],[["  "],["siguiente","identifier"],[" "],["<-","operator"],[" "],["x","identifier"],[" "],["+","operator"],[" "],["1","literalNumber"],[";","punctuation"]],[["EndFunction","keywordProcedural"]],[],[["Function","keywordProcedural"],[" "],["barato","identifier"],[" "],["<-","operator"],[" "]