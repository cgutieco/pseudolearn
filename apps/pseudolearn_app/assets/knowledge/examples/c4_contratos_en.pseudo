interface Readable
method getValue(value as integer) as integer;
endInterface

class Reader implements Readable
    public method getValue(value as integer) as integer
        return value + 1;
    endMethod
endClass

class Writer implements Readable
    public method getValue(value as integer) as integer
        return value * 2;
    endMethod
endClass

algorithm CompareContracts
    define mutable value as integer <- 0;
    read value;
    define reader as Reader <- new Reader();
    define writer as Writer <- new Writer();
    write reader.getValue(value);
    write writer.getValue(value);
endAlgorithm
