Proceso BuscarElemento
    Dimension numeros[5] Como Entero;
    Definir objetivo Como Entero <- 0;
    Para i <- 0 Hasta 4 Con Paso 1 Hacer
        Leer numeros[i];
    FinPara
    Leer objetivo;
    Definir indice Como Entero <- -1;
    Para i <- 0 Hasta 4 Con Paso 1 Hacer
        Si numeros[i] = objetivo Entonces
            indice <- i;
        FinSi
    FinPara
    Escribir indice;
FinProceso
