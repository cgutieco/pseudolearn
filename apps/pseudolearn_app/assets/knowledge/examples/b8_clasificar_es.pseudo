Proceso ContarAprobados
    Definir cantidad Como Entero <- 0;
    Definir nota Como Entero <- 0;
    Leer cantidad;
    Definir aprobados Como Entero <- 0;
    Para i <- 1 Hasta cantidad Con Paso 1 Hacer
        Leer nota;
        Si nota >= 5 Entonces
            aprobados <- aprobados + 1;
        FinSi
    FinPara
    Escribir aprobados;
FinProceso
