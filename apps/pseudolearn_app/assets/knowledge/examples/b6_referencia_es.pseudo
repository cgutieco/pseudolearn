SubProceso Intercambiar(a Como Entero Por Referencia, b Como Entero Por Referencia)
    Definir auxiliar Como Entero <- a;
    a <- b;
    b <- auxiliar;
FinSubProceso

Proceso ProbarIntercambio
    Definir Mutable n1 Como Entero <- 0;
    Definir Mutable n2 Como Entero <- 0;
    Leer n1;
    Leer n2;
    Intercambiar(n1, n2);
    Escribir n1;
    Escribir n2;
FinProceso
