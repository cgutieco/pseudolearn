Proceso SumaDeMatriz
    Dimension datos[2, 3] Como Entero;
    Para fila <- 0 Hasta 1 Con Paso 1 Hacer
        Para columna <- 0 Hasta 2 Con Paso 1 Hacer
            Leer datos[fila, columna];
        FinPara
    FinPara
    Definir Mutable total Como Entero <- 0;
    Para fila <- 0 Hasta 1 Con Paso 1 Hacer
        Para columna <- 0 Hasta 2 Con Paso 1 Hacer
            total <- total + datos[fila, columna];
        FinPara
    FinPara
    Escribir total;
FinProceso
