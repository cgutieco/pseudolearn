algorithm SearchElement
    dimension numbers[5] as integer;
    define mutable target as integer <- 0;
    for i <- 0 to 4 step 1 do
        read numbers[i];
    endFor
    read target;
    define mutable index as integer <- -1;
    for i <- 0 to 4 step 1 do
        if numbers[i] = target then
            index <- i;
        endIf
    endFor
    write index;
endAlgorithm
