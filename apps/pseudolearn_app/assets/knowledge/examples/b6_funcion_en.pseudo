subroutine Maximum(a as integer, b as integer) as integer
    if a > b then
        return a;
    else
        return b;
    endIf
endSubroutine

algorithm ComputeMaximum
    define mutable x as integer <- 0;
    define mutable y as integer <- 0;
    read x;
    read y;
    write Maximum(x, y);
endAlgorithm
