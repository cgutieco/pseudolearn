subroutine Swap(a as integer by reference, b as integer by reference)
    define auxiliary as integer <- a;
    a <- b;
    b <- auxiliary;
endSubroutine

algorithm TrySwap
    define mutable x as integer <- 0;
    define mutable y as integer <- 0;
    read x;
    read y;
    Swap(x, y);
    write x;
    write y;
endAlgorithm
