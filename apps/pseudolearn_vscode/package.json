{
  "name": "pseudolearn-vscode",
  "displayName": "PseudoLearn",
  "publisher": "pseudolearn",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": "22.23.3",
    "vscode": "^1.144.0"
  },
  "packageManager": "pnpm@12.8.1",
  "main": "./dist/extension.js",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "languages": [
      {
        "id": "pseudolearn",
        "aliases": ["PseudoLearn", "pseudolearn"],
        "extensions": [".pseudo"]
      }
    ]
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "third-party-notices.md",
    "package.json",
    "dist/**",
    "bin/**"
  ],
  "scripts": {
    "check:types": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "package": "pnpm build && node scripts/package.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.144.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
