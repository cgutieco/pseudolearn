{
  "name": "pseudolearn-vscode",
  "displayName": "PseudoLearn",
  "publisher": "pseudolearn",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": "22.23.3",
    "vscode": "^1.144.0"
  },
  "packageManager": "pnpm@12.8.1",
  "main": "./dist/extension.js",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished", "onLanguage:pseudolearn"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "PseudoLearn provides declarative highlighting in Restricted Mode. Executable overrides require a trusted development workspace.",
      "restrictedConfigurations": ["pseudolearn.server.path"]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "pseudolearn",
        "aliases": ["PseudoLearn", "pseudolearn"],
        "extensions": [".pseudo"],
        "configuration": "./media/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pseudolearn",
        "scopeName": "source.pseudolearn",
        "path": "./media/pseudolearn.tmLanguage.json"
      }
    ],
    "commands": [
      { "command": "pseudolearn.runFile", "title": "Run File", "category": "PseudoLearn" },
      { "command": "pseudolearn.runProject", "title": "Run Project", "category": "PseudoLearn" },
      { "command": "pseudolearn.stopRun", "title": "Stop Run", "category": "PseudoLearn" },
      { "command": "pseudolearn.selectEntry", "title": "Select Project Entry", "category": "PseudoLearn" },
      { "command": "pseudolearn.explainAtCursor", "title": "Explain at Cursor", "category": "PseudoLearn" },
      { "command": "pseudolearn.translate", "title": "Translate Vocabulary", "category": "PseudoLearn" },
      { "command": "pseudolearn.restartServer", "title": "Restart Language Server", "category": "PseudoLearn" }
    ],
    "keybindings": [
      {
        "command": "pseudolearn.explainAtCursor",
        "key": "ctrl+k ctrl+e",
        "mac": "cmd+k cmd+e",
        "when": "editorLangId == pseudolearn"
      }
    ],
    "configuration": {
      "title": "PseudoLearn",
      "properties": {
        "pseudolearn.profile": {
          "type": "string",
          "enum": ["es", "en"],
          "default": "es",
          "scope": "window",
          "description": "Fallback vocabulary profile for workspace analyses."
        },
        "pseudolearn.strictness": {
          "type": "string",
          "enum": ["strict", "flexible"],
          "default": "strict",
          "scope": "window",
          "description": "Analysis strictness for this workspace."
        },
        "pseudolearn.interfaceLanguage": {
          "type": "string",
          "enum": ["es", "en"],
          "default": "es",
          "scope": "machine",
          "description": "Personal language for PseudoLearn diagnostics and extension messages."
        },
        "pseudolearn.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute user-only path to a development server executable."
        }
      }
    }
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "third-party-notices.md",
    "package.json",
    "dist/**",
    "bin/**",
    "media/**"
  ],
  "scripts": {
    "check:types": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:package": "node scripts/check-package.mjs",
    "generate:grammar": "node scripts/generate-grammar.mjs",
    "check:grammar": "node scripts/generate-grammar.mjs --check",
    "test": "vitest run",
    "build:cli": "node scripts/build-cli.mjs",
    "build": "pnpm check:grammar && node scripts/build.mjs",
    "package": "pnpm build:cli && pnpm build && node scripts/package.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.144.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.3.2",
    "vitest": "5.0.4"
  }
}
