{
  "identity": { "publisher": "pseudolearn", "name": "pseudolearn-vscode", "version": "0.1.0" },
  "engines": { "vscode": "^1.144.0", "node": "22.23.3" },
  "target": {
    "vscodeTarget": "darwin-arm64",
    "cargoTarget": "aarch64-apple-darwin",
    "platform": "darwin",
    "architecture": "arm64"
  },
  "artifactName": "pseudolearn-0.1.0-darwin-arm64.vsix",
  "executable": "bin/darwin-arm64/pseudo",
  "grammar": "media/pseudolearn.tmLanguage.json",
  "languageConfiguration": "media/language-configuration.json",
  "bundle": "dist/extension.js",
  "license": "LICENSE.md",
  "required": [
    "package.json",
    "readme.md",
    "LICENSE.md",
    "third-party-notices.md",
    "dist/extension.js",
    "bin/darwin-arm64/pseudo",
    "media/pseudolearn.tmLanguage.json",
    "media/language-configuration.json"
  ],
  "allowedPrefixes": ["dist/", "bin/darwin-arm64/", "media/"],
  "allowedFiles": ["package.json", "readme.md", "LICENSE.md", "third-party-notices.md"],
  "forbiddenSegments": ["src", "tests", "scripts", "examples", "node_modules", ".git", ".artifacts", "test-results"],
  "forbiddenSuffixes": [".map"],
  "forbiddenPrefixes": [".env"],
  "bundledRuntimeModules": ["vscode-languageclient"],
  "externalRuntimeModules": ["vscode"],
  "hashAlgorithm": "sha256"
}
