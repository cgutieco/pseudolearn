---
import { useTranslations } from '@shared/i18n/translator';
import type { Locale } from '@shared/i18n/locales';
import { RichText } from '@shared/ui/rich-text';
import { groupChangesByKind } from '@entities/release/model/group-changes';
import type { Release } from '@entities/release/model/release';

export interface Props {
  locale: Locale;
  release: Release;
}

const { locale, release } = Astro.props;
const { t, plural } = useTranslations(locale);
const groups = groupChangesByKind(release.changes);
---

<div class="release-changes">
  {groups.map((group) => (
    <section class="release-changes__group">
      <h4 class="release-changes__kind">
        <span class="pl-overline">{t(`versions.kind.${group.kind}`)}</span>
        <span class="pl-mono release-changes__count">
          {plural('versions.changeCount', group.changes.length)}
        </span>
      </h4>
      <ul class="release-changes__rows">
        {group.changes.map((change) => (
          <li class="release-changes__row">
            <span class="pl-overline pl-overline--brand release-changes__label">{change.title[locale]}</span>
            <RichText as="p" class="release-changes__text" text={change.description[locale]} />
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .release-changes__group {
    margin-top: 20px;
  }

  .release-changes__kind {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--pl-line-soft);
  }

  .release-changes__count {
    font-size: 12px;
    font-weight: 400;
    color: var(--pl-ink-3);
  }

  .release-changes__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 7px;
    padding: 14px 0;
    border-bottom: 1px solid var(--pl-line-soft);
  }

  .release-changes__row:last-child {
    border-bottom: 0;
  }

  .release-changes__label {
    padding-top: 2px;
  }

  .release-changes :global(.release-changes__text) {
    max-width: 760px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--pl-ink-2);
  }

  .release-changes :global(.release-changes__text code) {
    font-family: var(--pl-font-code), sans-serif;
    font-size: 13px;
    color: var(--pl-ink);
  }

  @media (min-width: 900px) {
    .release-changes__group {
      margin-top: 26px;
    }

    .release-changes__row {
      grid-template-columns: 190px minmax(0, 1fr);
      gap: var(--pl-space-lg);
      padding: var(--pl-space-md) 0;
    }

    .release-changes :global(.release-changes__text) {
      font-size: 15px;
    }
  }
</style>
