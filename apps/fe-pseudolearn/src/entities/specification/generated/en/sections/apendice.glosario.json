{"id":"apendice.glosario","number":"E.1","kind":"apendice","title":[{"type":"text","text":"Glossary"}],"phrase":[],"blocks":[{"type":"paragraph","runs":[{"type":"text","text":"The book's technical terms with a short definition and the section where they are explained."}]},{"type":"table","header":[[{"type":"text","text":"Term"}],[{"type":"text","text":"Definition"}]],"rows":[[[{"type":"text","text":"algorithm"}],[{"type":"text","text":"The main unit of a program; every text has exactly one. "},{"type":"link","section":"programas.estructura","text":"Structure"}]],[[{"type":"text","text":"argument"}],[{"type":"text","text":"The value passed in a call. "},{"type":"link","section":"subprogramas.parametros","text":"Parameters"}]],[[{"type":"text","text":"assignment"}],[{"type":"text","text":"Storing a new value in a place with "},{"type":"code","tokens":[["<-","operator"]]},{"type":"text","text":". "},{"type":"link","section":"declaraciones.asignacion","text":"Assignment"}]],[[{"type":"text","text":"base case"}],[{"type":"text","text":"The case of a recursion that is solved without calling itself again. "},{"type":"link","section":"subprogramas.recursion","text":"Recursion"}]],[[{"type":"text","text":"capability"}],[{"type":"text","text":"An opaque key that gives access to an outside resource. "},{"type":"link","section":"tareas.efectos","text":"Effects and capabilities"}]],[[{"type":"text","text":"class"}],[{"type":"text","text":"A type that groups attributes and methods; its values are objects. "},{"type":"link","section":"objetos.clase","text":"Classes"}]],[[{"type":"text","text":"constant"}],[{"type":"text","text":"A name for a fixed value computed during analysis. "},{"type":"link","section":"declaraciones.constante","text":"Constants"}]],[[{"type":"text","text":"designator"}],[{"type":"text","text":"An expression that names a place to store into: variable, cell or attribute. "},{"type":"link","section":"declaraciones.designadores","text":"Designators"}]],[[{"type":"text","text":"diagnostic"}],[{"type":"text","text":"An engine notice with a code, class, severity and position. "},{"type":"link","section":"diagnosticos.anatomia","text":"Anatomy"}]],[[{"type":"text","text":"dispatch"}],[{"type":"text","text":"Choosing the method by the object's real class. "},{"type":"link","section":"objetos.herencia","text":"Inheritance"}]],[[{"type":"text","text":"effect"}],[{"type":"text","text":"Any action towards the outside of the program: writing, reading, opening a file. "},{"type":"link","section":"motor.efectos","text":"Effect order"}]],[[{"type":"text","text":"expression"}],[{"type":"text","text":"A combination of values and operators that is computed. "},{"type":"link","section":"expresiones.aritmeticos","text":"Arithmetic"}]],[[{"type":"text","text":"frame"}],[{"type":"text","text":"The space of its own every call has for its parameters and variables. "},{"type":"link","section":"subprogramas.llamada","text":"Calls"}]],[[{"type":"text","text":"handle"}],[{"type":"text","text":"The "},{"type":"code","tokens":[["Task","type"]]},{"type":"text","text":" value that keeps a spawned task to wait for its result. "},{"type":"link","section":"tareas.ambitos","text":"Task scopes"}]],[[{"type":"text","text":"heap"}],[{"type":"text","text":"The memory where objects, arrays and texts created at run time live. "},{"type":"link","section":"motor.memoria","text":"Memory"}]],[[{"type":"text","text":"host"}],[{"type":"text","text":"Whoever runs the program —the app, the terminal or an executable— and gives it input, output and capabilities. "},{"type":"link","section":"tareas.efectos","text":"Effects"}]],[[{"type":"text","text":"identity"}],[{"type":"text","text":"An object's or array's creation number; it never changes and is never reused. "},{"type":"link","section":"objetos.copia","text":"Copies and identity"}]],[[{"type":"text","text":"interface"}],[{"type":"text","text":"A list of signatures a class promises to fulfil. "},{"type":"link","section":"objetos.interfaces","text":"Interfaces"}]],[[{"type":"text","text":"intermediate representation"}],[{"type":"text","text":"The form of simple instructions the engine translates the program into. "},{"type":"link","section":"motor.capas","text":"Layers"}]],[[{"type":"text","text":"module"}],[{"type":"text","text":"A file in a project. "},{"type":"link","section":"programas.modulos","text":"Modules"}]],[[{"type":"text","text":"object"}],[{"type":"text","text":"A class-typed value, created with "},{"type":"code","tokens":[["New","keywordOop"]]},{"type":"text","text":". "},{"type":"link","section":"objetos.constructor","text":"Constructors"}]],[[{"type":"text","text":"pass by reference"}],[{"type":"text","text":"Passing the variable itself, not a copy. "},{"type":"link","section":"subprogramas.referencia","text":"By reference"}]],[[{"type":"text","text":"precedence"}],[{"type":"text","text":"The order in which operators group. "},{"type":"link","section":"expresiones.precedencia","text":"Precedence"}]],[[{"type":"text","text":"profile"}],[{"type":"text","text":"The language of the program's words: Spanish or English. "},{"type":"link","section":"lectura.perfiles","text":"Profiles"}]],[[{"type":"text","text":"pure function"}],[{"type":"text","text":"A "},{"type":"code","tokens":[["Function","keywordProcedural"]]},{"type":"text","text":", which only computes and has no effects. "},{"type":"link","section":"subprogramas.pureza","text":"Purity"}]],[[{"type":"text","text":"receiver"}],[{"type":"text","text":"The object a method is called on, named "},{"type":"code","tokens":[["This","keywordOop"]]},{"type":"text","text":" inside it. "},{"type":"link","section":"objetos.metodos","text":"Methods"}]],[[{"type":"text","text":"scope"}],[{"type":"text","text":"The stretch of text where a name exists, from its declaration to the end of its block. "},{"type":"link","section":"subprogramas.ambito","text":"Scopes"}]],[[{"type":"text","text":"severity"}],[{"type":"text","text":"A diagnostic's consequence: error, warning or information. "},{"type":"link","section":"diagnosticos.severidad","text":"Severity"}]],[[{"type":"text","text":"short circuit"}],[{"type":"text","text":"Leaving the right side of "},{"type":"code","tokens":[["And","operator"]]},{"type":"text","text":" or "},{"type":"code","tokens":[["Or","operator"]]},{"type":"text","text":" uncomputed when the left side already decides. "},{"type":"link","section":"expresiones.logicos","text":"Logical"}]],[[{"type":"text","text":"suspendible"}],[{"type":"text","text":"A unit that can pause at "},{"type":"code","tokens":[["Await","keywordStructured"]]},{"type":"text","text":". "},{"type":"link","section":"tareas.suspendible","text":"Suspendible units"}]],[[{"type":"text","text":"tape"}],[{"type":"text","text":"The record of a run's effects, which allows replaying it. "},{"type":"link","section":"motor.efectos","text":"Effects and tape"}]],[[{"type":"text","text":"task"}],[{"type":"text","text":"A run that progresses alongside others inside a "},{"type":"code","tokens":[["Tasks","keywordStructured"]]},{"type":"text","text":" scope. "},{"type":"link","section":"tareas.ambitos","text":"Task scopes"}]],[[{"type":"text","text":"trace"}],[{"type":"text","text":"The list of a run's events, step by step. "},{"type":"link","section":"motor.observacion","text":"Observing execution"}]],[[{"type":"text","text":"trap"}],[{"type":"text","text":"A failure during execution that stops the program. "},{"type":"link","section":"vision.errores","text":"Errors"}]],[[{"type":"text","text":"variable"}],[{"type":"text","text":"A name bound to a place in memory whose value can change. "},{"type":"link","section":"declaraciones.definir","text":"Define"}]]]}]}
